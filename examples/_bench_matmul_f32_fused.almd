// Fused scale+mul via cblas_sgemm alpha. Eliminates intermediate Vec<f32>
// allocation that plagues the unfused bench at 256-512².
import env

effect fn bench(label: String, n: Int, iters: Int) -> () = {
  let a = matrix.ones(n, n) |> (m) => matrix.scale(m, 0.001)
  let b = matrix.ones(n, n) |> (m) => matrix.scale(m, 0.001)
  let _w = matrix.get(matrix.scale(a * b, 1.0), 0, 0) ?? panic("matrix.get: out of range")
  let t0 = datetime.now_ms()
  var i = 0
  var acc = 0.0
  while i < iters {
    let eps = 1.0 + float.from(i) * 0.000000001
    // Fused: single sgemm call with alpha = eps. No scale alloc.
    let r = matrix.scale(a * b, eps)
    acc = acc + (matrix.get(r, 0, 0) ?? panic("matrix.get: out of range"))
    i = i + 1
  }
  let el = datetime.now_ms() - t0
  let tf = 2 * n * n * n
  let gflops = float.from(tf * iters) / (float.from(el) / 1000.0) / 1e9
  let usc = float.from(el) * 1000.0 / float.from(iters)
  println(label + " " + int.to_string(n) + "² iter=" + int.to_string(iters) + ": " + int.to_string(el) + "ms " + float.to_string(gflops) + " GFLOPS " + float.to_string(usc) + "µs/call (acc=" + float.to_string(acc) + ")")
}

effect fn main() -> () = {
  println("Almide f32 FUSED matmul (mul_f32_scaled): no intermediate alloc")
  // Higher iters for ms-precision timers (each size targets 500+ ms total)
  bench("sq", 128, 20000)
  bench("sq", 256, 5000)
  bench("sq", 384, 2000)
  bench("sq", 512, 1000)
  bench("sq", 768, 400)
  bench("sq", 1024, 200)
}
