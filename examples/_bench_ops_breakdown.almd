// Per-op breakdown to find the real dispatch bottleneck at small sizes.
import env

effect fn bench_op(label: String, iters: Int, body: () -> Float) -> () = {
  // warm
  let _ = body()
  let t0 = datetime.now_ms()
  var i = 0
  var acc = 0.0
  while i < iters {
    acc = acc + body()
    i = i + 1
  }
  let elapsed = datetime.now_ms() - t0
  let us_per = float.from(elapsed) * 1000.0 / float.from(iters)
  println(label + ": " + int.to_string(elapsed) + "ms / " + int.to_string(iters) + " = " + float.to_string(us_per) + "µs/call (acc=" + float.to_string(acc) + ")")
}

effect fn main() -> () = {
  let a = matrix.ones(3, 3) |> (m) => matrix.scale(m, 0.001)
  let b = matrix.ones(3, 3) |> (m) => matrix.scale(m, 0.001)

  println("=== 3x3 op breakdown ===")
  bench_op("scale only    ", 100000, () => matrix.get(matrix.scale(a, 1.001), 0, 0) ?? panic("matrix.get: out of range"))!
  bench_op("mul only      ", 100000, () => matrix.get(a * b, 0, 0) ?? panic("matrix.get: out of range"))!
  bench_op("get only      ", 100000, () => matrix.get(a, 0, 0) ?? panic("matrix.get: out of range"))!
  bench_op("scale+mul+get ", 100000, () => {
    let a_i = matrix.scale(a, 1.001)
    matrix.get(a_i * b, 0, 0) ?? panic("matrix.get: out of range")
  })!
}
