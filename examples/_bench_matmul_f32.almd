// f32 matmul throughput vs NumPy f32 (1136 GFLOPS peak on Apple Silicon).
// Uses matrix.{ones,mul,get}_f32 preview APIs.
import env

effect fn bench(label: String, n: Int, iters: Int) -> () = {
  let a = matrix.ones(n, n) |> (m) => matrix.scale(m, 0.001)
  let b = matrix.ones(n, n) |> (m) => matrix.scale(m, 0.001)
  let _w = matrix.get(a * b, 0, 0)
  let t0 = datetime.now_ms()
  var i = 0
  var acc = 0.0
  while i < iters {
    let eps = 1.0 + float.from(i) * 0.000000001
    let ai = matrix.scale(a, eps)
    let r = ai * b
    acc = acc + matrix.get(r, 0, 0)
    i = i + 1
  }
  let el = datetime.now_ms() - t0
  let tf = 2 * n * n * n
  let gflops = float.from(tf * iters) / (float.from(el) / 1000.0) / 1e9
  let usc = float.from(el) * 1000.0 / float.from(iters)
  println(label + " " + int.to_string(n) + "² iter=" + int.to_string(iters) + ": " + int.to_string(el) + "ms " + float.to_string(gflops) + " GFLOPS " + float.to_string(usc) + "µs/call (acc=" + float.to_string(acc) + ")")
}

effect fn main() -> () = {
  println("Almide f32 matmul throughput (cblas_sgemm direct)")
  bench("sq", 128, 20000)
  bench("sq", 256, 5000)
  bench("sq", 384, 2000)
  bench("sq", 512, 1000)
  bench("sq", 768, 400)
  bench("sq", 1024, 200)
}
