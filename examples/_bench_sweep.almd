import env

effect fn bench_size(n: Int, iters: Int) -> () = {
  let a = matrix.ones(n, n) |> (m) => matrix.scale(m, 0.001)
  let b = matrix.ones(n, n) |> (m) => matrix.scale(m, 0.001)
  let _w = matrix.get(a * b, 0, 0) ?? panic("matrix.get: out of range")
  let t0 = datetime.now_ms()
  var i = 0
  var acc = 0.0
  while i < iters {
    let eps = 1.0 + float.from(i) * 0.000000001
    let ai = matrix.scale(a, eps)
    let r = ai * b
    acc = acc + (matrix.get(r, 0, 0) ?? panic("matrix.get: out of range"))
    i = i + 1
  }
  let el = datetime.now_ms() - t0
  let tf = 2 * n * n * n
  let gflops = float.from(tf * iters) / (float.from(el) / 1000.0) / 1e9
  let usc = float.from(el) * 1000.0 / float.from(iters)
  println(int.to_string(n) + "² iter=" + int.to_string(iters) + ": " + int.to_string(el) + "ms " + float.to_string(gflops) + " GFLOPS " + float.to_string(usc) + "µs/call")
}

effect fn main() -> () = {
  bench_size(128, 390)
  bench_size(192, 260)
  bench_size(256, 195)
  bench_size(320, 156)
  bench_size(384, 130)
  bench_size(512, 97)
  bench_size(768, 65)
  bench_size(1024, 48)
}
