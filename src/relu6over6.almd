// relu6_over6 — ReLU6(x)/6 = clip(x,0,6)/6. The [0,1]-normalized ReLU6: 0 for
// x≤0, ramping linearly to 1 at x≥6. A fixed-scale piecewise-linear gate
// (mobile-friendly probability-like output). Elementwise.

import math

fn relu6_over6(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.fmax(0.0, math.fmin(6.0, x)) / 6.0)

// clamps below 0 / above 6; 3/6 = 0.5 at the midpoint.
test "relu6_over6 clamps and is half at three" {
  let y = relu6_over6(matrix.from_lists([[-2.0, 3.0, 10.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 0, 1), 0.5)
  assert_eq(matrix.get(y, 0, 2), 1.0)
}
