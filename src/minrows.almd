// min_rows — minimum over each row → (T,1). Min pooling readout (mirror of
// max_rows). Seeded with +1e38 as the identity for fmin.

import math

fn min_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, _) = matrix.shape(x)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let xn = list.get_or(rx, n, [])
    let m = xn |> list.fold(1.0e38, (acc, v) => math.fmin(acc, v))
    out = out + [[m]]
    n = n + 1
  }
  matrix.from_lists(out)
}

test "min_rows picks the minimum" {
  let y = min_rows(matrix.from_lists([[1.0, 5.0, 3.0, 2.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

test "min_rows of all-negative row" {
  let y = min_rows(matrix.from_lists([[-2.0, -7.0, -3.0]]))
  assert_eq(matrix.get(y, 0, 0), -7.0)
}
