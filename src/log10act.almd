// log10_act — log10(1 + |x|). Base-10 (decade/order-of-magnitude) compression
// of magnitude; positive, monotone in |x|, even. Elementwise.

import math

fn log10_act(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.log10(float.abs(x) + 1.0))

test "log10_act at zero is zero" {
  let y = log10_act(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// log10(1+9)=1, log10(1+99)=2.
test "log10_act at 9 and 99" {
  let y = log10_act(matrix.from_lists([[9.0, 99.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "log10(10)=1")
  assert(float.abs(matrix.get(y, 0, 1) - 2.0) < 0.000000001, "log10(100)=2")
}
