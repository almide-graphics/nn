// mae_rows — row-wise mean absolute error of two matrices:
//
//   mae_r = (1/D) · Σ_j |a_rj − b_rj|
//
// One value per row → output (T,1). The L1 / robust regression loss (less
// outlier-sensitive than mse_rows). Two-input row reduction.

import float

fn mae_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, d) = matrix.shape(a)
  let df = int.to_float(d)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let an = list.get_or(ra, n, [])
    let bn = list.get_or(rb, n, [])
    let sae = list.zip_with(an, bn, (x, y) => float.abs(x - y)) |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[sae / df]]
    n = n + 1
  }
  matrix.from_lists(out)
}

// mae(a, a) = 0.
test "mae of identical rows is zero" {
  let a = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let y = mae_rows(a, a)
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// (|1|+|3|)/2 = 2.
test "mae computes mean absolute error" {
  let a = matrix.from_lists([[0.0, 0.0]])
  let b = matrix.from_lists([[1.0, 3.0]])
  let y = mae_rows(a, b)
  assert_eq(matrix.get(y, 0, 0), 2.0)
}
