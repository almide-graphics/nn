// min_pool1d_k2_rows — 1-D min pooling with kernel 2, stride 2, along each row:
//   out_{t,j} = min(x_{t,2j}, x_{t,2j+1})   for j = 0 … D/2−1   → (T, D/2).
// Non-overlapping min-pool downsampling, the third of the canonical 1-D pools (max / avg / min): each
// adjacent pair collapses to its smaller value, halving the width. Min pooling surfaces the
// worst-case / quietest feature of each window (used e.g. for anti-max saliency and morphological
// erosion). Distinct from min_rows (a full-row reduction to a scalar); this is a windowed reduction
// that changes the shape to (T, D/2). Even D; scans in steps of two (no integer division). Output (T, D/2).

import math

fn min_pool1d_k2_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var row: List[Float] = []
    var j = 0
    while j < d {
      let a = list.get_or(xi, j, 0.0)
      let b = list.get_or(xi, j + 1, 0.0)
      row = row + [math.fmin(a, b)]
      j = j + 2
    }
    out = out + [row]
    i = i + 1
  }
  matrix.from_lists(out)
}

// each adjacent pair collapses to its min: [1,3,2,5] → [1,2].
test "min-pool-1d takes the min of each adjacent pair" {
  let x = matrix.from_lists([[1.0, 3.0, 2.0, 5.0]])
  let y = min_pool1d_k2_rows(x)
  assert_eq(matrix.get(y, 0, 0), 1.0)
  assert_eq(matrix.get(y, 0, 1), 2.0)
}

// negatives: keeps the smaller (more negative) of each pair: [−1,−3,−5,−2] → [−3,−5].
test "min-pool-1d keeps the smaller of each negative pair" {
  let x = matrix.from_lists([[0.0 - 1.0, 0.0 - 3.0, 0.0 - 5.0, 0.0 - 2.0]])
  let y = min_pool1d_k2_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0 - 3.0)
  assert_eq(matrix.get(y, 0, 1), 0.0 - 5.0)
}
