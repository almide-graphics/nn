// ternary_quant_error_l2_rows — per-row L2 norm of the TWN ternary quantization residual.
//   Δ_t = 0.7·(1/D)Σ_j|x_{t,j}|,  α_t = mean of |x| over kept {j: |x|>Δ_t}
//   q_{t,j} = α_t·(+1 if x>Δ ; −1 if x<−Δ ; 0)
//   out_t = sqrt( Σ_j (x_{t,j} − q_{t,j})² )           → one norm per row, (T,1).
// The magnitude of the noise TWN ternary injects into each row: the length of the residual
// that ternary_quant_error_rows leaves behind. The ternary sibling of quant_error_l2_rows
// (which scores binary b1) — together with ternary_quant_error_rows (the residual vector) and
// ternary_quant_snr_rows (the power ratio) this completes the TWN diagnostics trio. α and the
// cut match ternary_quant_error_rows. Per-row reduction (sum of squared residuals, rooted).
// Output (T,1).

import float
import math

fn ternary_quant_error_l2_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  let df = int.to_float(d)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    let s = xi |> list.fold(0.0, (acc, v) => acc + float.abs(v))
    let delta = 0.7 * (s / df)
    let count = xi |> list.fold(0.0, (acc, v) => acc + (if float.abs(v) > delta then 1.0 else 0.0))
    let above = xi |> list.fold(0.0, (acc, v) => acc + (if float.abs(v) > delta then float.abs(v) else 0.0))
    let alpha = if count > 0.0 then above / count else 0.0
    let sq = xi |> list.fold(0.0, (acc, v) => {
      let q = if v > delta then alpha else (if v < (0.0 - delta) then 0.0 - alpha else 0.0)
      let e = v - q
      acc + e * e
    })
    out = out + [[math.sqrt(sq)]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// [3,−4,0.1,0.05]: residual [−0.5,−0.5,0.1,0.05]; Σe²=0.5125 → ‖e‖ = sqrt(0.5125).
test "ternary-quant-error-l2 is the norm of the ternary residual" {
  let x = matrix.from_lists([[3.0, 0.0 - 4.0, 0.1, 0.05]])
  let y = ternary_quant_error_l2_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - math.sqrt(0.5125)) < 0.000000001, "sqrt(0.5125)")
}

// an already-ternary row [2,2,−2,−2] has zero residual → norm 0.
test "an already-ternary row has zero residual norm" {
  let x = matrix.from_lists([[2.0, 2.0, 0.0 - 2.0, 0.0 - 2.0]])
  let y = ternary_quant_error_l2_rows(x)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "exact ternary → 0")
}
