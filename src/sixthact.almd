// sixth_act — x⁶, computed as (x³)². Even, convex, very flat near 0 and steep
// far out — a high-order even polynomial feature. Elementwise.

fn sixth_act(m: Matrix) -> Matrix =
  matrix.map(m, (x) => {
    let s = x * x * x
    s * s
  })

test "sixth_act at zero is zero" {
  let y = sixth_act(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// 2⁶=64; even.
test "sixth_act at 2 and even" {
  let y = sixth_act(matrix.from_lists([[2.0, -2.0]]))
  assert_eq(matrix.get(y, 0, 0), 64.0)
  assert_eq(matrix.get(y, 0, 1), 64.0)
}
