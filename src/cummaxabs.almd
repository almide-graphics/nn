// cummax_abs_rows — cumulative maximum of absolute value over time (down rows):
//   out_t = max_{i≤t} |x_i|   (elementwise per channel).
// The running L∞ envelope / peak magnitude of a sequence — a streaming dynamic-
// range tracker (e.g. for per-channel activation clipping / quantization scale).
// Seeds with zero since |·| ≥ 0. O(T), O(D) state. Output (T,D).

import float
import math

fn cummax_abs_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var acc: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    acc = list.zip_with(acc, xi, (a, b) => math.fmax(a, float.abs(b)))
    out = out + [acc]
    i = i + 1
  }
  matrix.from_lists(out)
}

// running peak magnitude of [1,-3,2] (single channel) → [1,3,3].
test "cummax abs is the running L-infinity envelope" {
  let x = matrix.from_lists([[1.0], [0.0 - 3.0], [2.0]])
  let y = cummax_abs_rows(x)
  assert_eq(matrix.get(y, 0, 0), 1.0)
  assert_eq(matrix.get(y, 1, 0), 3.0)
  assert_eq(matrix.get(y, 2, 0), 3.0)
}

// per channel: [[2,-1],[-5,3]] → row1 = [max(2,5), max(1,3)] = [5,3].
test "cummax abs works per channel" {
  let x = matrix.from_lists([[2.0, 0.0 - 1.0], [0.0 - 5.0, 3.0]])
  let y = cummax_abs_rows(x)
  assert_eq(matrix.get(y, 1, 0), 5.0)
  assert_eq(matrix.get(y, 1, 1), 3.0)
}
