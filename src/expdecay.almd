// exp_decay — exp(-|x|). The Laplace/exponential kernel: peaks at 1, decays
// symmetrically with a cusp at 0 (heavier tails than a Gaussian). Elementwise.

import math

fn exp_decay(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - float.abs(x)))

test "exp_decay peaks at one when x=0" {
  let y = exp_decay(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// exp(-1) and even.
test "exp_decay at 1 and even" {
  let y = exp_decay(matrix.from_lists([[1.0, -1.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "exp(-1)")
  assert(float.abs(matrix.get(y, 0, 1) - 0.36787944117144233) < 0.000000001, "even")
}
