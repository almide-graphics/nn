// negate — elementwise -x. A trivial but composable building block (e.g.
// flipping logits, residual subtraction). Elementwise.

fn negate(m: Matrix) -> Matrix =
  matrix.map(m, (x) => 0.0 - x)

test "negate flips sign" {
  let y = negate(matrix.from_lists([[3.0, -5.0, 0.0]]))
  assert_eq(matrix.get(y, 0, 0) ?? panic("matrix.get: out of range"), -3.0)
  assert_eq(matrix.get(y, 0, 1) ?? panic("matrix.get: out of range"), 5.0)
  assert_eq(matrix.get(y, 0, 2) ?? panic("matrix.get: out of range"), 0.0)
}
