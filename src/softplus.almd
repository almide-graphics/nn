// softplus — log(1 + exp(x)), numerically stable form:
//   softplus(x) = max(x, 0) + log(1 + exp(-|x|)).
// Smooth ReLU; also the building block of mish. Elementwise.

import math

fn softplus(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.fmax(x, 0.0) + math.log(1.0 + math.exp(0.0 - float.abs(x))))

test "softplus at zero is log 2" {
  let y = softplus(matrix.from_lists([[0.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.6931471805599453) < 0.000000001, "softplus(0)=ln2")
}
