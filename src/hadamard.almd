// hadamard — elementwise (Hadamard) product of two equal-shape matrices.
// The matrix stdlib has matrix.mul (matrix product) and matrix.map (unary), but
// no elementwise binary product — yet it is needed everywhere (gating, masking,
// B̄=Δ⊙B, …). Built row-wise via list.zip_with.

fn hadamard(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, _) = matrix.shape(a)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let an = list.get_or(ra, n, [])
    let bn = list.get_or(rb, n, [])
    out = out + [list.zip_with(an, bn, (x, y) => x * y)]
    n = n + 1
  }
  matrix.from_lists(out)
}

// a ⊙ 1 = a.
test "hadamard with ones is identity" {
  let a = matrix.from_lists([[2.0, 3.0], [4.0, 5.0]])
  let ones = matrix.from_lists([[1.0, 1.0], [1.0, 1.0]])
  let y = hadamard(a, ones)
  assert_eq(matrix.get(y, 0, 1), 3.0)
  assert_eq(matrix.get(y, 1, 0), 4.0)
}

// a ⊙ 0 = 0.
test "hadamard with zeros is zero" {
  let a = matrix.from_lists([[2.0, 3.0]])
  let zeros = matrix.from_lists([[0.0, 0.0]])
  let y = hadamard(a, zeros)
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 0, 1), 0.0)
}
