// rms_time_rows — per-channel RMS normalization over time (axis=0):
//   out_t = x_t / σ_c,  σ_c = sqrt( mean_t x_{t,c}² ).
// Scales each channel by its temporal root-mean-square (no centering) — the
// axis=0 RMS-norm of a sequence, distinct from the per-row rms_normalize_vec.
// Two passes. Output (T,D).

import math

fn rms_time_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  let tf = int.to_float(t)
  var ss: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    ss = list.zip_with(ss, xi, (a, b) => a + b * b)
    i = i + 1
  }
  let rms = ss |> list.map((v) => math.sqrt(v / tf))
  var out: List[List[Float]] = []
  var j = 0
  while j < t {
    let xj = list.get_or(rx, j, [])
    out = out + [list.zip_with(xj, rms, (a, b) => a / b)]
    j = j + 1
  }
  matrix.from_lists(out)
}

// single channel [3,4]: rms = sqrt((9+16)/2) = sqrt(12.5) → [3/√12.5, 4/√12.5].
// use [2,2]: rms = sqrt((4+4)/2)=2 → [1,1].
test "rms time of a constant-magnitude channel normalizes to one" {
  let x = matrix.from_lists([[2.0], [2.0]])
  let y = rms_time_rows(x)
  assert_eq(matrix.get(y, 0, 0), 1.0)
  assert_eq(matrix.get(y, 1, 0), 1.0)
}

// per channel: ch0 [0,4] rms=sqrt(16/2)=sqrt(8); ch1 [3,3] rms=3 → ch1 → [1,1].
test "rms time normalizes each channel independently" {
  let x = matrix.from_lists([[0.0, 3.0], [4.0, 3.0]])
  let y = rms_time_rows(x)
  assert_eq(matrix.get(y, 0, 1), 1.0)
  assert_eq(matrix.get(y, 1, 1), 1.0)
}
