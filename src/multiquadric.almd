// multiquadric — √(1 + x²). Hardy's multiquadric RBF: even, ≥1, grows like |x|
// for large |x| (an unbounded, smooth |x| approximation). Elementwise.

import math

fn multiquadric(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.sqrt(1.0 + x * x))

test "multiquadric at zero is one" {
  let y = multiquadric(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// √(1+3)=2 at x=√3; even.
test "multiquadric at sqrt3 is 2 and even" {
  let y = multiquadric(matrix.from_lists([[1.7320508075688772, -1.7320508075688772]]))
  assert(float.abs(matrix.get(y, 0, 0) - 2.0) < 0.000000001, "= 2")
  assert(float.abs(matrix.get(y, 0, 1) - 2.0) < 0.000000001, "even")
}
