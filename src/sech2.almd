// sech2 — sech²(x) = 1 - tanh²(x). The derivative of tanh; an even bump peaking
// at 1, decaying to 0. tanh built from exp (bound via a let inside map).
// Elementwise.

import math

fn sech2(m: Matrix) -> Matrix =
  matrix.map(m, (x) => {
    let t = 2.0 / (1.0 + math.exp(0.0 - 2.0 * x)) - 1.0
    1.0 - t * t
  })

test "sech2 at zero is one" {
  let y = sech2(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// saturates to 0; even.
test "sech2 saturates to zero and even" {
  let y = sech2(matrix.from_lists([[30.0, -30.0]]))
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "→ 0")
  assert(float.abs(matrix.get(y, 0, 1)) < 0.000000001, "even")
}
