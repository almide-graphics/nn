// erosion1d_rows — 1-D grayscale morphological erosion along each row (axis=1):
//   out_{t,j} = min( x_{t,j-1}, x_{t,j}, x_{t,j+1} )   (edge replication at the borders)   → (T,D).
// The sliding 3-window minimum (stride 1, same padding): every position takes the smallest value in
// its neighbourhood, so dark troughs widen and thin spikes are eaten away. It is the dual of
// dilation1d_rows (the window maximum) — together they are the morphological pair the way max/min and
// hardmax/hardmin are throughout this library, and composing them gives opening/closing. Distinct from
// min_pool1d (k=2, stride 2, which *downsamples* to (T,D/2)); erosion keeps the (T,D) shape. One
// neighbourhood scan with replicated edges. Output (T,D).

import float
import math

fn erosion1d_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var row: List[Float] = []
    var j = 0
    while j < d {
      let lo = if j > 0 then j - 1 else 0
      let hi = if j < d - 1 then j + 1 else d - 1
      let a = list.get_or(xi, lo, 0.0)
      let b = list.get_or(xi, j, 0.0)
      let c = list.get_or(xi, hi, 0.0)
      row = row + [math.fmin(math.fmin(a, b), c)]
      j = j + 1
    }
    out = out + [row]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a thin spike is eaten away by its low neighbours: [9,0,9] → [0,0,0].
test "erosion eats away a thin spike" {
  let x = matrix.from_lists([[9.0, 0.0, 9.0]])
  let y = erosion1d_rows(x)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "min(9,9,0)=0")
  assert(float.abs(matrix.get(y, 0, 1)) < 0.000000001, "min(9,0,9)=0")
  assert(float.abs(matrix.get(y, 0, 2)) < 0.000000001, "min(0,9,9)=0")
}

// a monotone row takes the backward neighbour; the first edge replicates itself.
test "erosion of a monotone row takes the backward neighbour" {
  let x = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let y = erosion1d_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "min(1,1,2)=1")
  assert(float.abs(matrix.get(y, 0, 3) - 3.0) < 0.000000001, "min(3,4,4)=3")
}
