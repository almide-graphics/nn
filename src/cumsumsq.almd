// cumsum_sq_rows — cumulative sum of squares over time (down the rows):
//   out_t = Σ_{i≤t} x_i²   (elementwise per channel).
// The running energy / accumulated second moment of a sequence (the numerator of
// a streaming variance / RMS estimate). Monotone non-decreasing. O(T), O(D) state.
// Output (T,D).

fn cumsum_sq_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var acc: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    acc = list.zip_with(acc, xi, (a, b) => a + b * b)
    out = out + [acc]
    i = i + 1
  }
  matrix.from_lists(out)
}

// squares of [2,3] (single channel) accumulate to [4,13].
test "cumsum sq accumulates energy down rows" {
  let x = matrix.from_lists([[2.0], [3.0]])
  let y = cumsum_sq_rows(x)
  assert_eq(matrix.get(y, 0, 0), 4.0)
  assert_eq(matrix.get(y, 1, 0), 13.0)
}

// per channel: [[1,2],[2,1]] → row1 = [1+4, 4+1] = [5,5].
test "cumsum sq works per channel" {
  let x = matrix.from_lists([[1.0, 2.0], [2.0, 1.0]])
  let y = cumsum_sq_rows(x)
  assert_eq(matrix.get(y, 1, 0), 5.0)
  assert_eq(matrix.get(y, 1, 1), 5.0)
}
