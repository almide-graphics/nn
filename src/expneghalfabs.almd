// exp_neg_half_abs — exp(-|x|/2). A wider-scale Laplace (double-exponential)
// kernel: even, peaks at 1, with a sharp cusp at 0 and a slower decay than
// exp(-|x|) (scale = 2). Elementwise.

import math

fn exp_neg_half_abs(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - 0.5 * float.abs(x)))

test "exp_neg_half_abs peaks at one when x=0" {
  let y = exp_neg_half_abs(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// exp(-|2|/2)=exp(-1) at x=2; even.
test "exp_neg_half_abs at 2 and even" {
  let y = exp_neg_half_abs(matrix.from_lists([[2.0, -2.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "e⁻¹")
  assert(float.abs(matrix.get(y, 0, 1) - 0.36787944117144233) < 0.000000001, "even")
}
