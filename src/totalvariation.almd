// total_variation_rows — per-row total variation (axis=1):
//   out_t = Σ_{j=0}^{D-2} |x_{t,j+1} − x_{t,j}|   → (T,1).
// The L1 path length / total-variation seminorm of a row: the cumulative absolute change as you walk
// along the feature axis — small for smooth rows, large for jagged ones. It is the quantity TV
// regularization / TV denoising penalizes. Distinct from abs_diff_rows (the per-step |Δ|, which keeps
// the (T,D) shape) and from range (max−min, the endpoint span): TV is the full walked length, always
// ≥ range (equal only for a monotone row, strictly larger when the path reverses). One adjacent-
// difference scan. Output (T,1).

import float

fn total_variation_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var s = 0.0
    var j = 0
    while j < d - 1 {
      s = s + float.abs(list.get_or(xi, j + 1, 0.0) - list.get_or(xi, j, 0.0))
      j = j + 1
    }
    out = out + [[s]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a monotone row: TV equals the total rise = range. [1,2,3,4] → 1+1+1 = 3.
test "total variation of a monotone row equals its total rise" {
  let x = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let y = total_variation_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 3.0) < 0.000000001, "1+1+1=3")
}

// a zigzag accumulates every swing: [0,2,0,2] → 2+2+2 = 6 (≫ range 2).
test "total variation accumulates each zigzag swing" {
  let x = matrix.from_lists([[0.0, 2.0, 0.0, 2.0]])
  let y = total_variation_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 6.0) < 0.000000001, "2+2+2=6")
}
