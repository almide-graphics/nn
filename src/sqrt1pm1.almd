// sqrt1p_minus1 — √(1+|x|) - 1. An even, sub-linear magnitude transform: 0 at
// the origin, grows like √|x| (gentler than |x|, no flat tail). Heavy-tail
// feature compression. Elementwise.

import math

fn sqrt1p_minus1(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.sqrt(1.0 + float.abs(x)) - 1.0)

test "sqrt1p_minus1 at zero is zero" {
  let y = sqrt1p_minus1(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// √(1+3)-1 = 1; even.
test "sqrt1p_minus1 at 3 and even" {
  let y = sqrt1p_minus1(matrix.from_lists([[3.0, -3.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
  assert_eq(matrix.get(y, 0, 1), 1.0)
}
