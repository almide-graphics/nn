// median_rows — per-row true median, sort-free via rank selection (axis=1):
//   rank_j = #{ k : x_k < x_j },   lo = (D−1)/2,  hi = D/2   (integer division),
//   out_t = ( os(lo) + os(hi) ) / 2,   where os(m) = the element whose rank is m.    → (T,1).
// The genuine row median (robust central tendency): for odd D, lo==hi picks the single middle order
// statistic; for even D it averages the two middles — exactly numpy's convention. Order statistics are
// extracted without a sort by the same all-pairs rank count used in rank_rows: with continuous data
// there are no ties, so each rank is held by exactly one element and os(m) = Σ_j x_j·[rank_j==m].
// Distinct from median3_filter_rows (a length-3 time-axis filter) and from mean (outlier-sensitive).
// Output (T,1).

import float

fn median_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  let lo = (d - 1) / 2
  let hi = d / 2
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var oslo = 0.0
    var oshi = 0.0
    var j = 0
    while j < d {
      let xj = list.get_or(xi, j, 0.0)
      var rank = 0
      var k = 0
      while k < d {
        rank = if list.get_or(xi, k, 0.0) < xj then rank + 1 else rank
        k = k + 1
      }
      oslo = if rank == lo then oslo + xj else oslo
      oshi = if rank == hi then oshi + xj else oshi
      j = j + 1
    }
    out = out + [[(oslo + oshi) / 2.0]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// even length: median averages the two middle order statistics. [3,1,4,2] → (2+3)/2 = 2.5.
test "median of an even-length row averages the two middles" {
  let x = matrix.from_lists([[3.0, 1.0, 4.0, 2.0]])
  let y = median_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 2.5) < 0.000000001, "(2+3)/2=2.5")
}

// odd length: median is the single middle value. [10,30,20] → 20.
test "median of an odd-length row is the middle value" {
  let x = matrix.from_lists([[10.0, 30.0, 20.0]])
  let y = median_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 20.0) < 0.000000001, "20")
}
