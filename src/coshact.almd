// cosh_act — hyperbolic cosine (eˣ+e⁻ˣ)/2. Even, ≥1, convex; the catenary /
// even companion of tanh. Keep |x| moderate. Elementwise.

import math

fn cosh_act(m: Matrix) -> Matrix =
  matrix.map(m, (x) => (math.exp(x) + math.exp(0.0 - x)) / 2.0)

test "cosh at zero is one" {
  let y = cosh_act(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// cosh(1) = (e + 1/e)/2; even so cosh(-1) matches.
test "cosh at 1 is correct and even" {
  let y = cosh_act(matrix.from_lists([[1.0, -1.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 1.5430806348152437) < 0.000000001, "cosh(1)")
  assert(float.abs(matrix.get(y, 0, 1) - 1.5430806348152437) < 0.000000001, "even")
}
