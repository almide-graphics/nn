// relu6 — ReLU clamped at 6: min(max(x, 0), 6). Quantization-friendly bounded
// activation (MobileNet). Elementwise.

import math

fn relu6(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.fmin(math.fmax(x, 0.0), 6.0))

// Below 0 → 0, in [0,6] → identity, above 6 → 6.
test "relu6 clamps to [0,6]" {
  let y = relu6(matrix.from_lists([[-3.0, 3.0, 10.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 0, 1), 3.0)
  assert_eq(matrix.get(y, 0, 2), 6.0)
}
