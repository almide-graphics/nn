// log10_quad — log10(1 + x²). Even, ≥0, base-10 (decade) compression of the
// squared magnitude — a very robust, order-of-magnitude penalty. Elementwise.

import math

fn log10_quad(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.log10(1.0 + x * x))

test "log10_quad at zero is zero" {
  let y = log10_quad(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// log10(1+9)=log10(10)=1 at x=3; even.
test "log10_quad at 3 and even" {
  let y = log10_quad(matrix.from_lists([[3.0, -3.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "= 1")
  assert(float.abs(matrix.get(y, 0, 1) - 1.0) < 0.000000001, "even")
}
