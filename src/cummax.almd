// cummax_rows — cumulative maximum over time (down the rows): out_t = max_{i≤t} x_i
// (elementwise per channel). The max analogue of cumsum_rows; a running-peak
// sequence primitive (e.g. monotone envelopes / hard attention pooling over a
// prefix). Seeds the running state with the first row (so negatives are handled).
// O(T), O(D) state. Output (T,D).

import math

fn cummax_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, _) = matrix.shape(x)
  var acc: List[Float] = list.get_or(rx, 0, [])
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    acc = list.zip_with(acc, xi, (a, b) => math.fmax(a, b))
    out = out + [acc]
    i = i + 1
  }
  matrix.from_lists(out)
}

// running max down the rows: [1,2]→[3,2]→[3,5].
test "cummax accumulates the running max down rows" {
  let x = matrix.from_lists([[1.0, 2.0], [3.0, 1.0], [2.0, 5.0]])
  let y = cummax_rows(x)
  assert_eq(matrix.get(y, 0, 0), 1.0)
  assert_eq(matrix.get(y, 1, 0), 3.0)
  assert_eq(matrix.get(y, 2, 1), 5.0)
}

// single channel stays at the running peak: 5,5,8.
test "cummax holds the peak" {
  let x = matrix.from_lists([[5.0], [3.0], [8.0]])
  let y = cummax_rows(x)
  assert_eq(matrix.get(y, 0, 0), 5.0)
  assert_eq(matrix.get(y, 1, 0), 5.0)
  assert_eq(matrix.get(y, 2, 0), 8.0)
}
