// l3_norm_rows — the L3 (cubic) norm value of each row (axis=1):
//   out_t = ( Σ_j |x_{t,j}|³ )^{1/3}                   → one value per row, (T,1).
// The p=3 member of the Lp family, sitting between the Euclidean L2 and the max-norm L∞:
// it weights large coordinates more than L2 but, unlike L∞, still sees all of them. A
// scalar magnitude per row (distinct from l2_normalize, which rescales the vector, and from
// l2_dist_rows, a two-input distance). Sign-blind and ≥ the largest |coordinate|. fpow with
// exponent 1/3 handles the cube root (0-row → 0, no guard needed). Per-row reduction.
// Output (T,1).

import float
import math

fn l3_norm_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    let s = xi |> list.fold(0.0, (acc, v) => {
      let a = float.abs(v)
      acc + a * a * a
    })
    out = out + [[math.fpow(s, 1.0 / 3.0)]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// one-hot row [3,0,0,0]: Σ|x|³ = 27 → (27)^{1/3} = 3.
test "l3-norm of a one-hot row is its single magnitude" {
  let x = matrix.from_lists([[3.0, 0.0, 0.0, 0.0]])
  let y = l3_norm_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 3.0) < 0.000000001, "(27)^(1/3)=3")
}

// the L3 norm depends only on magnitudes (sign-blind) and is ≥ the max |coordinate| (L∞).
test "l3-norm is sign-blind and at least the L-infinity norm" {
  let yp = l3_norm_rows(matrix.from_lists([[5.0, 1.0, 0.0]]))
  let yn = l3_norm_rows(matrix.from_lists([[0.0 - 5.0, 0.0 - 1.0, 0.0]]))
  assert(float.abs(matrix.get(yp, 0, 0) - matrix.get(yn, 0, 0)) < 0.000000001, "‖x‖₃ = ‖|x|‖₃")
  assert(matrix.get(yp, 0, 0) > 5.0, "≥ L∞ = 5")
}
