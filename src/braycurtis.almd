// bray_curtis_dist_rows — row-wise Bray–Curtis dissimilarity of two matrices:
//   dist_t = ( Σ_j |a_{t,j} − b_{t,j}| ) / ( Σ_j (|a_{t,j}| + |b_{t,j}|) + ε )   ∈ [0,1], (T,1).
// A total-normalized L1 dissimilarity: the summed absolute difference divided by the summed
// magnitude. Distinct from canberra_dist_rows, which normalizes each coordinate by its own
// |a|+|b| before summing; Bray–Curtis normalizes once by the grand total, so large
// coordinates dominate. The standard abundance dissimilarity in ecology / recommender
// overlap. The +ε guards an all-zero pair. Two-input row reduction (two folds, one ratio).
// Output (T,1).

import float

fn bray_curtis_dist_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, _) = matrix.shape(a)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let num = list.zip_with(ai, bi, (x, y) => float.abs(x - y)) |> list.fold(0.0, (acc, v) => acc + v)
    let den = list.zip_with(ai, bi, (x, y) => float.abs(x) + float.abs(y)) |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[num / (den + 0.000000000001)]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a row has zero Bray–Curtis distance to itself (numerator 0).
test "bray-curtis distance of identical rows is zero" {
  let a = matrix.from_lists([[1.0, 0.0 - 2.0, 3.0, 4.0]])
  let y = bray_curtis_dist_rows(a, a)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "self → 0")
}

// [1,2] vs [3,0]: num=|1−3|+|2−0|=4; den=(1+3)+(2+0)=6 → 4/6 = 2/3.
test "bray-curtis is total abs diff over total magnitude" {
  let a = matrix.from_lists([[1.0, 2.0]])
  let b = matrix.from_lists([[3.0, 0.0]])
  let y = bray_curtis_dist_rows(a, b)
  assert(float.abs(matrix.get(y, 0, 0) - 0.6666666666666666) < 0.0000001, "2/3")
}
