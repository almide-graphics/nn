// celu — Continuously differentiable ELU: x for x>0, else α·(exp(x/α)-1).
// α scalar (>0). Like ELU but C¹-continuous at 0 for any α. Elementwise.

import math

fn celu(m: Matrix, alpha: Float) -> Matrix =
  matrix.map(m, (x) => if x > 0.0 then x else alpha * (math.exp(x / alpha) - 1.0))

test "celu identity for positive" {
  let y = celu(matrix.from_lists([[3.0]]), 1.0)
  assert_eq(matrix.get(y, 0, 0), 3.0)
}

test "celu at zero is zero" {
  let y = celu(matrix.from_lists([[0.0]]), 1.5)
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

test "celu saturates to minus alpha" {
  let y = celu(matrix.from_lists([[-50.0]]), 2.0)
  assert(float.abs(matrix.get(y, 0, 0) + 2.0) < 0.000000001, "≈ -α")
}
