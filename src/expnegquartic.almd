// exp_neg_quartic — exp(-x⁴). A super-Gaussian (flat-top) window: even, peaks at
// 1, with a flatter plateau near 0 than a Gaussian and steeper skirts. A
// "boxier" soft mask. Elementwise.

import math

fn exp_neg_quartic(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - x * x * x * x))

test "exp_neg_quartic peaks at one when x=0" {
  let y = exp_neg_quartic(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// exp(-1) at x=1; even.
test "exp_neg_quartic at 1 and even" {
  let y = exp_neg_quartic(matrix.from_lists([[1.0, -1.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "e⁻¹")
  assert(float.abs(matrix.get(y, 0, 1) - 0.36787944117144233) < 0.000000001, "even")
}
