// minmax_rows — row-internal min-max normalization (axis=1):
//   out_{t,j} = (x_{t,j} − min_j x) / (max_j x − min_j x + ε)   ∈ [0,1],  (T,D).
// Rescales each row to the unit interval: its minimum maps to 0, its maximum to 1, the rest
// linearly between. The within-row feature-scaling counterpart of minmax_time_rows (which
// normalizes each channel over time, axis=0). Distinct from the L1/L2 normalizers (which scale
// by a norm, not the range). The +ε guards a constant row. Two passes per row (min/max, then
// rescale). Output (T,D).

import float
import math

fn minmax_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, _) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    let mn = xi |> list.fold(list.get_or(xi, 0, 0.0), (acc, v) => math.fmin(acc, v))
    let mx = xi |> list.fold(list.get_or(xi, 0, 0.0), (acc, v) => math.fmax(acc, v))
    let span = mx - mn
    out = out + [xi |> list.map((v) => (v - mn) / (span + 0.000000000001))]
    i = i + 1
  }
  matrix.from_lists(out)
}

// [2,4,6]: min 2 → 0, max 6 → 1, middle → 0.5.
test "minmax scales a row to [0,1] with min→0 and max→1" {
  let x = matrix.from_lists([[2.0, 4.0, 6.0]])
  let y = minmax_rows(x)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "min → 0")
  assert(float.abs(matrix.get(y, 0, 1) - 0.5) < 0.000000001, "mid → 0.5")
  assert(float.abs(matrix.get(y, 0, 2) - 1.0) < 0.000000001, "max → 1")
}

// handles negatives and is per-row: [−1,1]→[0,1]; [−3,3] max→1.
test "minmax handles negatives and works per row" {
  let x = matrix.from_lists([[0.0 - 1.0, 1.0], [0.0 - 3.0, 3.0]])
  let y = minmax_rows(x)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "row0 min → 0")
  assert(float.abs(matrix.get(y, 0, 1) - 1.0) < 0.000000001, "row0 max → 1")
  assert(float.abs(matrix.get(y, 1, 1) - 1.0) < 0.000000001, "row1 max → 1")
}
