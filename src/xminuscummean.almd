// x_minus_cummean_rows — deviation of each step from the running mean (down rows):
//   μ_t = (1/(t+1)) Σ_{i≤t} x_i,   out_t = x_t − μ_t   (elementwise per channel).
// The online "innovation": how far the current value sits above/below the average of
// everything seen so far. A causal, expanding-window demean (the streaming cousin of
// center_rows, which removes the global mean). Row 0 is always 0. Built from one running
// sum accumulator. O(T), O(D) state. Output (T,D).

fn x_minus_cummean_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var s: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    s = list.zip_with(s, xi, (a, b) => a + b)
    let n = int.to_float(i + 1)
    out = out + [list.zip_with(xi, s, (a, sa) => a - sa / n)]
    i = i + 1
  }
  matrix.from_lists(out)
}

// column 0 = [2,4,9]: cummean = [2,3,5], deviation = [0,1,4].
test "x-minus-cummean is the deviation from the running average" {
  let x = matrix.from_lists([[2.0], [4.0], [9.0]])
  let y = x_minus_cummean_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 1, 0), 1.0)
  assert_eq(matrix.get(y, 2, 0), 4.0)
}

// the first row equals its own mean, so its deviation is zero everywhere.
test "x-minus-cummean starts at zero on the first row" {
  let x = matrix.from_lists([[0.0 - 3.0, 5.0], [1.0, 1.0]])
  let y = x_minus_cummean_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 0, 1), 0.0)
}
