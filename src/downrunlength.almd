// down_run_length_rows — length of the current consecutive-decrease streak over time (per channel):
//   out_{t,j} = (x_{t,j} < x_{t-1,j}) ? out_{t-1,j} + 1 : 0,   out_{0,j} = 0   → (T,D), integer-valued.
// The down-side companion of up_run_length_rows: how many steps in a row the sequence has strictly
// fallen, ending at t — the duration of the current decline (e.g. a drawdown's length, a loss's
// consecutive-worsening streak). The library carries max/min pairs throughout (cummax/cummin,
// cumargmax/cumargmin); this is a genuinely distinct computation (strict "<", not up_run with
// swapped data). One O(D) carry of (previous row, running length); a flat or rising step resets.
// Output (T,D).

fn down_run_length_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var prev = list.get_or(rx, 0, [])
  var run: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var nr: List[Float] = []
    var j = 0
    while j < d {
      let xv = list.get_or(xi, j, 0.0)
      let pv = list.get_or(prev, j, 0.0)
      let rv = list.get_or(run, j, 0.0)
      nr = nr + [if xv < pv then rv + 1.0 else 0.0]
      j = j + 1
    }
    run = nr
    out = out + [run]
    prev = xi
    i = i + 1
  }
  matrix.from_lists(out)
}

// a monotonic decrease grows the streak: [4,3,2,1] → [0,1,2,3].
test "down-run-length grows on a monotonic decrease" {
  let x = matrix.from_lists([[4.0], [3.0], [2.0], [1.0]])
  let y = down_run_length_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 1, 0), 1.0)
  assert_eq(matrix.get(y, 2, 0), 2.0)
  assert_eq(matrix.get(y, 3, 0), 3.0)
}

// a rise resets the streak: [2,1,2,1] → [0,1,0,1].
test "down-run-length resets to zero on an increase" {
  let x = matrix.from_lists([[2.0], [1.0], [2.0], [1.0]])
  let y = down_run_length_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 1, 0), 1.0)
  assert_eq(matrix.get(y, 2, 0), 0.0)
  assert_eq(matrix.get(y, 3, 0), 1.0)
}
