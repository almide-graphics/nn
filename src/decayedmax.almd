// decayed_max_rows — leaky / decaying running maximum over time (down the rows, per channel):
//   m_t = max(x_t, β·m_{t-1}),   m_0 = x_0,   β = 0.9   → (T,D).
// A peak-hold envelope follower with decay: it jumps up instantly to any new high, then leaks down
// geometrically (by β each step) while the input stays below it. This is the classic audio/peak
// detector and a momentum-style "recent best with forgetting". Distinct from cummax_rows (β = 1, a
// non-decaying running max that never forgets) and from ema (a mean, not a max). One O(D)-state
// recurrence; β=0.9 fixed. Output (T,D).

import float
import math

fn decayed_max_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var m = list.get_or(rx, 0, [])
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    m = if i > 0 then list.zip_with(xi, m, (xv, mv) => math.fmax(xv, 0.9 * mv)) else m
    out = out + [m]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a spike held then leaking by 0.9: [10,0,0] → [10, 9, 8.1].
test "decayed max holds a peak and leaks by the decay" {
  let x = matrix.from_lists([[10.0], [0.0], [0.0]])
  let y = decayed_max_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 10.0) < 0.000000001, "10")
  assert(float.abs(matrix.get(y, 1, 0) - 9.0) < 0.000000001, "max(0,0.9·10)=9")
  assert(float.abs(matrix.get(y, 2, 0) - 8.1) < 0.000000001, "max(0,0.9·9)=8.1")
}

// a new higher peak overrides the decayed hold: [1,5,2] → [1, 5, 4.5].
test "decayed max jumps up to a new higher peak" {
  let x = matrix.from_lists([[1.0], [5.0], [2.0]])
  let y = decayed_max_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "1")
  assert(float.abs(matrix.get(y, 1, 0) - 5.0) < 0.000000001, "max(5,0.9)=5")
  assert(float.abs(matrix.get(y, 2, 0) - 4.5) < 0.000000001, "max(2,4.5)=4.5")
}
