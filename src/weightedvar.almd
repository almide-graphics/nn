// weighted_var_rows — per-row weighted variance with explicit (non-negative) weights (2-input):
//   μ_w = Σ_j w_{t,j}·x_{t,j} / (Σ_j w_{t,j} + ε),
//   out_t = Σ_j w_{t,j}·(x_{t,j} − μ_w)² / (Σ_j w_{t,j} + ε)   → (T,1).
// The second moment companion of weighted_mean_rows: the spread of x about its weight-weighted mean,
// using the weights as given (importance / inverse-variance / frequency weighting). Distinct from
// variance_rows (uniform weights) and from softmax_weighted_var_rows, which turns its scores into
// weights via softmax — here w is used directly, normalized by Σw. Uniform weights recover the
// population variance; a one-hot weight gives 0 (a single point has no spread). Two passes
// (weighted mean, then weighted squared deviation). Output (T,1).

import float

fn weighted_var_rows(x: Matrix, w: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let rw = matrix.to_lists(w)
  let (t, _) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    let wi = list.get_or(rw, i, [])
    let sw = wi |> list.fold(0.0, (acc, v) => acc + v)
    let mu = (list.zip_with(xi, wi, (xv, wv) => xv * wv) |> list.fold(0.0, (acc, v) => acc + v)) / (sw + 0.000000000001)
    let wvar = (list.zip_with(xi, wi, (xv, wv) => wv * (xv - mu) * (xv - mu)) |> list.fold(0.0, (acc, v) => acc + v)) / (sw + 0.000000000001)
    out = out + [[wvar]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// uniform weights recover the population variance: var([1,2,3,4]) = 5/4 = 1.25.
test "weighted variance with uniform weights is the population variance" {
  let x = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let w = matrix.from_lists([[1.0, 1.0, 1.0, 1.0]])
  let y = weighted_var_rows(x, w)
  assert(float.abs(matrix.get(y, 0, 0) - 1.25) < 0.000000001, "5/4=1.25")
}

// a single weighted point has no spread → 0.
test "weighted variance of a single weighted point is zero" {
  let x = matrix.from_lists([[1.0, 2.0, 3.0]])
  let w = matrix.from_lists([[0.0, 1.0, 0.0]])
  let y = weighted_var_rows(x, w)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.0000001, "0")
}
