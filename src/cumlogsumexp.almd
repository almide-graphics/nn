// cumulative_logsumexp_rows — cumulative log-sum-exp over time (down the rows, per channel):
//   out_t = log( Σ_{i≤t} exp(x_i) )   (elementwise per channel).
// The running log-partition: the log-domain prefix-sum that an online / streaming softmax keeps
// (the denominator a flash-attention pass accumulates as it scans keys). out_0 = x_0; each step
// folds in the next term, and the result is monotone non-decreasing. Distinct from
// logsumexp_rows (a single reduction over a row, axis=1), from logsumexp_time_rows (the full
// time-axis log-softmax) and from abs_cumsum (a raw prefix sum). One running accumulator of
// Σexp, logged each step. O(T), O(D) state. Output (T,D).

import math

fn cumulative_logsumexp_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var acc: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    acc = list.zip_with(acc, xi, (a, v) => a + math.exp(v))
    out = out + [acc |> list.map((s) => math.log(s))]
    i = i + 1
  }
  matrix.from_lists(out)
}

// the first step has one term: out_0 = log(exp(x_0)) = x_0.
test "first row of cumulative-logsumexp equals the input" {
  let x = matrix.from_lists([[2.0], [3.0]])
  let y = cumulative_logsumexp_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 2.0) < 0.000000001, "log(exp 2)=2")
}

// [0,0]: out = [log 1, log 2] = [0, 0.6931…].
test "cumulative-logsumexp accumulates terms in the log domain" {
  let x = matrix.from_lists([[0.0], [0.0]])
  let y = cumulative_logsumexp_rows(x)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "log 1 = 0")
  assert(float.abs(matrix.get(y, 1, 0) - 0.6931471805599453) < 0.000000001, "log 2")
}
