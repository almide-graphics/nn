// signed_cube_root_rows — signed cube root, sign(x)·|x|^(1/3), elementwise.
//   out_{t,j} = sign(x_{t,j}) · |x_{t,j}|^(1/3),   sign(0) = 0 ⇒ out = 0
// A stronger odd variance-stabilizer than signed_sqrt: it flattens heavy tails harder
// (cube root vs square root) while staying smooth through the origin and odd
// (f(−x) = −f(x)). Unlike the real cube root it is built on |x| so the fractional power
// only ever sees a non-negative base (negative^(1/3) would be NaN). math.sign is Int-only
// so the sign is the usual ±1/0 threshold; math.fpow gives the Float exponent. Purely
// elementwise. Output (T,D).

import float
import math

fn signed_cube_root_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, _d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    let row = xi |> list.map((v) => {
      let s = if v > 0.0 then 1.0 else (if v < 0.0 then 0.0 - 1.0 else 0.0)
      s * math.fpow(float.abs(v), 1.0 / 3.0)
    })
    out = out + [row]
    i = i + 1
  }
  matrix.from_lists(out)
}

// 8 → 2, −27 → −3, 0 → 0.
test "signed-cube-root inverts the signed cube" {
  let x = matrix.from_lists([[8.0, 0.0 - 27.0], [0.0, 1.0]])
  let y = signed_cube_root_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 2.0) < 0.000000001, "cbrt 8 = 2")
  assert(float.abs(matrix.get(y, 0, 1) - (0.0 - 3.0)) < 0.000000001, "cbrt -27 = -3")
  assert_eq(matrix.get(y, 1, 0), 0.0)
  assert(float.abs(matrix.get(y, 1, 1) - 1.0) < 0.000000001, "cbrt 1 = 1")
}

// odd symmetry: f(v) + f(−v) = 0 exactly.
test "signed-cube-root is an odd function" {
  let x = matrix.from_lists([[5.0]])
  let xn = matrix.from_lists([[0.0 - 5.0]])
  let a = matrix.get(signed_cube_root_rows(x), 0, 0)
  let b = matrix.get(signed_cube_root_rows(xn), 0, 0)
  assert_eq(a + b, 0.0)
}
