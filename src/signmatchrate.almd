// sign_match_rate_rows — per-row fraction of sign agreements between two matrices.
//   out_t = (1/D) Σ_j [ sign(a_{t,j}) = sign(b_{t,j}) ]   → one fraction per row, (T,1).
// The normalized companion of binary_dot / hamming_sign: what share of a row's bits a
// 1-bit (BitNet) update keeps aligned — a direct, scale-free read of sign overlap
// (1 = identical signs, 0 = fully opposed). Sign codes (both in {−1,0,1}) are compared
// by |s_a − s_b| < 0.5 for "equal". Two-input row reduction. Output (T,1).

import float

fn sign_match_rate_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, d) = matrix.shape(a)
  let df = int.to_float(d)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let agree = list.zip_with(ai, bi, (u, v) => {
      let su = if u > 0.0 then 1.0 else (if u < 0.0 then 0.0 - 1.0 else 0.0)
      let sv = if v > 0.0 then 1.0 else (if v < 0.0 then 0.0 - 1.0 else 0.0)
      if float.abs(su - sv) < 0.5 then 1.0 else 0.0
    }) |> list.fold(0.0, (acc, p) => acc + p)
    out = out + [[agree / df]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a=[+,+,−,−], b=[+,−,−,+]: agree at j=0,2 → 2/4 = 0.5.
test "sign-match-rate is the fraction of agreeing signs" {
  let a = matrix.from_lists([[1.0, 2.0, 0.0 - 3.0, 0.0 - 4.0]])
  let b = matrix.from_lists([[5.0, 0.0 - 6.0, 0.0 - 7.0, 8.0]])
  let y = sign_match_rate_rows(a, b)
  assert_eq(matrix.get(y, 0, 0), 0.5)
}

// a matrix agrees fully with itself → rate 1.
test "sign-match-rate of a matrix with itself is one" {
  let a = matrix.from_lists([[7.0, 0.0 - 3.0, 9.0]])
  let y = sign_match_rate_rows(a, a)
  assert_eq(matrix.get(y, 0, 0), 1.0)
}
