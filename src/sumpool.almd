// sumpool_rows — sum over each row → (T,1). Sum pooling / bag-of-features
// readout; complements global_meanpool_rows.

fn sumpool_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, _) = matrix.shape(x)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let xn = list.get_or(rx, n, [])
    let s = xn |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[s]]
    n = n + 1
  }
  matrix.from_lists(out)
}

test "sumpool computes the row sum" {
  let y = sumpool_rows(matrix.from_lists([[1.0, 2.0, 3.0, 4.0]]))
  assert_eq(matrix.get(y, 0, 0), 10.0)
}

test "sumpool of zeros is zero" {
  let y = sumpool_rows(matrix.from_lists([[0.0, 0.0, 0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}
