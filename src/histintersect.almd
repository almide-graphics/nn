// hist_intersection_rows — per-row histogram-intersection kernel of two non-negative rows (2-input):
//   out_t = Σ_j min(a_{t,j}, b_{t,j})   → (T,1).
// The overlap / intersection kernel: the shared area under two histograms (bag-of-words, colour
// histograms). It is a positive-definite similarity (large when the distributions co-occupy the same
// bins), the dual notion to the distances here — a *sum of overlaps* rather than a sum of
// differences. Distinct from elementwise_min_rows (which keeps the (T,D) per-bin minima) and from
// min_pool / l1 distance: this reduces the per-bin minima to one similarity score. Identical
// histograms give their total mass; disjoint ones give 0. Inputs non-negative. Output (T,1).

import float
import math

fn hist_intersection_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, _) = matrix.shape(a)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let s = list.zip_with(ai, bi, (av, bv) => math.fmin(av, bv)) |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[s]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// identical histograms: Σ min(a,a) = Σ a = 6.
test "histogram intersection of identical histograms is their total mass" {
  let a = matrix.from_lists([[1.0, 2.0, 3.0]])
  let b = matrix.from_lists([[1.0, 2.0, 3.0]])
  let y = hist_intersection_rows(a, b)
  assert(float.abs(matrix.get(y, 0, 0) - 6.0) < 0.000000001, "Σ=6")
}

// disjoint histograms share nothing: min is 0 everywhere → 0.
test "histogram intersection of disjoint histograms is zero" {
  let a = matrix.from_lists([[2.0, 0.0]])
  let b = matrix.from_lists([[0.0, 2.0]])
  let y = hist_intersection_rows(a, b)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "0")
}
