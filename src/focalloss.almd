// focal_loss_rows — per-row softmax focal loss against a target distribution (γ=2):
//   logp_j = x_j − (m + log Σ_i exp(x_i−m)),  p_j = exp(logp_j),  m = max_i x_i
//   out_t = −Σ_j target_{t,j} · (1 − p_j)² · logp_j        → one loss per row, (T,1).
// Cross-entropy modulated by the focusing factor (1−p)^γ (Lin et al. 2017, RetinaNet): it
// down-weights already-well-classified examples (p→1 ⇒ factor→0) so training focuses on the
// hard, mis-/under-confident ones. Reduces toward cross_entropy_rows as γ→0; here γ=2. Same
// numerically-stable log-softmax core as cross_entropy_rows. Two-input row reduction. (T,1).

import float
import math

fn focal_loss_rows(logits: Matrix, target: Matrix) -> Matrix = {
  let rl = matrix.to_lists(logits)
  let rt = matrix.to_lists(target)
  let (t, _) = matrix.shape(logits)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let ln = list.get_or(rl, n, [])
    let tn = list.get_or(rt, n, [])
    let mx = ln |> list.fold(0.0 - 1.0e38, (acc, v) => math.fmax(acc, v))
    let sumexp = ln |> list.fold(0.0, (acc, v) => acc + math.exp(v - mx))
    let lse = mx + math.log(sumexp)
    let terms = list.zip_with(tn, ln, (tt, xx) => {
      let logp = xx - lse
      let p = math.exp(logp)
      tt * (1.0 - p) * (1.0 - p) * logp
    })
    let fl = terms |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[0.0 - fl]]
    n = n + 1
  }
  matrix.from_lists(out)
}

// uniform logits [0,0], one-hot target [1,0]: p_true=0.5 → focal = (1−0.5)²·(−log0.5) = 0.25·log2.
test "focal loss applies the (1−p)² focusing factor to cross-entropy" {
  let logits = matrix.from_lists([[0.0, 0.0]])
  let target = matrix.from_lists([[1.0, 0.0]])
  let y = focal_loss_rows(logits, target)
  assert(float.abs(matrix.get(y, 0, 0) - 0.17328679513998632) < 0.000000001, "0.25·log2")
}

// a confident correct prediction is focused away → loss ≈ 0.
test "focal loss of a confident correct prediction is near zero" {
  let logits = matrix.from_lists([[100.0, 0.0]])
  let target = matrix.from_lists([[1.0, 0.0]])
  let y = focal_loss_rows(logits, target)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000001, "confident → ≈ 0")
}
