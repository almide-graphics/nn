// log_relu1p — log(1 + max(0, x)). A one-sided logarithmic gate: 0 for x≤0,
// then a sub-linear log growth for x>0 — compresses large positive activations
// while staying ≥0 and exactly 0 on the left. Elementwise.

import math

fn log_relu1p(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.log(1.0 + math.fmax(0.0, x)))

// 0 for x≤0 (incl. 0).
test "log_relu1p is zero for x<=0" {
  let y = log_relu1p(matrix.from_lists([[-3.0, 0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 0, 1), 0.0)
}

// log(1+(e-1)) = log(e) = 1.
test "log_relu1p at e-1 is one" {
  let y = log_relu1p(matrix.from_lists([[1.718281828459045]]))
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "= 1")
}
