// log_cosh_half — ½·log(cosh(x)). Half the log-cosh robust loss: even, ≥0,
// ≈¼x² near 0 and ≈½|x|-½log2 in the tails (Huber-like, smooth everywhere).
// Stable form log(cosh x) = |x| + log(1+e^{-2|x|}) - log2. Elementwise.

import math

fn log_cosh_half(m: Matrix) -> Matrix =
  matrix.map(m, (x) => {
    let a = float.abs(x)
    0.5 * (a + math.log(1.0 + math.exp(0.0 - 2.0 * a)) - 0.6931471805599453)
  })

// log(cosh 0)=log1=0 → 0 (the log2 terms cancel exactly).
test "log_cosh_half at zero is zero" {
  let y = log_cosh_half(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// even and strictly positive away from 0.
test "log_cosh_half even and positive" {
  let y = log_cosh_half(matrix.from_lists([[2.0, -2.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - matrix.get(y, 0, 1)) < 0.000000001, "even")
  assert(matrix.get(y, 0, 0) > 0.0, "≥0")
}
