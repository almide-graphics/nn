// avg_pool1d_k2_rows — 1-D average pooling with kernel 2, stride 2, along each row:
//   out_{t,j} = (x_{t,2j} + x_{t,2j+1}) / 2   for j = 0 … D/2−1   → (T, D/2).
// Non-overlapping mean-pool downsampling: each adjacent pair of features averages into one, halving
// the width — the smoothing counterpart of max_pool1d_k2_rows. Distinct from the full-row pools
// (global_meanpool reduces a whole row to a scalar); this is a windowed reduction that changes the
// shape to (T, D/2). Assumes an even D; scans in steps of two (no integer division). Output (T, D/2).

import float

fn avg_pool1d_k2_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var row: List[Float] = []
    var j = 0
    while j < d {
      let a = list.get_or(xi, j, 0.0)
      let b = list.get_or(xi, j + 1, 0.0)
      row = row + [(a + b) / 2.0]
      j = j + 2
    }
    out = out + [row]
    i = i + 1
  }
  matrix.from_lists(out)
}

// each adjacent pair averages: [1,3,2,5] → [2, 3.5].
test "avg-pool-1d averages each adjacent pair" {
  let x = matrix.from_lists([[1.0, 3.0, 2.0, 5.0]])
  let y = avg_pool1d_k2_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 2.0) < 0.000000001, "(1+3)/2=2")
  assert(float.abs(matrix.get(y, 0, 1) - 3.5) < 0.000000001, "(2+5)/2=3.5")
}

// constant pairs pass through: [0,0,4,4] → [0,4].
test "avg-pool-1d of constant pairs returns that value" {
  let x = matrix.from_lists([[0.0, 0.0, 4.0, 4.0]])
  let y = avg_pool1d_k2_rows(x)
  assert(float.abs(matrix.get(y, 0, 0)) < 0.000000001, "0")
  assert(float.abs(matrix.get(y, 0, 1) - 4.0) < 0.000000001, "4")
}
