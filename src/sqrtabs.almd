// sqrt_abs — √|x|. Signed-magnitude compression / kernel feature. Elementwise.

import math

fn sqrt_abs(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.sqrt(float.abs(x)))

test "sqrt_abs of magnitude" {
  let y = sqrt_abs(matrix.from_lists([[4.0, -9.0, 0.0]]))
  assert_eq(matrix.get(y, 0, 0), 2.0)
  assert_eq(matrix.get(y, 0, 1), 3.0)
  assert_eq(matrix.get(y, 0, 2), 0.0)
}
