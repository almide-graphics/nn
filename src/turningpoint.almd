// turning_point_count_rows — number of local extrema (direction reversals) in each row (axis=1):
//   out_t = #{ j ∈ 1..D−2 : sign(x_j − x_{j-1}) ≠ sign(x_{j+1} − x_j) }   → one count per row, (T,1).
// Counts where the row's first difference flips sign — i.e. local maxima/minima, the "turning
// points" of a sequence. A roughness / oscillation measure: 0 for a monotone row, up to D−2 for
// a full zigzag. Distinct from sign_change_rows (sign flips of the values themselves) and from
// autocorr_lag1_rows (a linear correlation); this counts changes of the derivative's sign.
// Index loop over interior positions. Integer-valued. Output (T,1).

fn turning_point_count_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    var cnt = 0.0
    var j = 1
    while j < d - 1 {
      let left = list.get_or(xi, j, 0.0) - list.get_or(xi, j - 1, 0.0)
      let right = list.get_or(xi, j + 1, 0.0) - list.get_or(xi, j, 0.0)
      let is_tp = if left > 0.0 then (if right < 0.0 then 1.0 else 0.0)
                  else (if left < 0.0 then (if right > 0.0 then 1.0 else 0.0) else 0.0)
      cnt = cnt + is_tp
      j = j + 1
    }
    out = out + [[cnt]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a monotone row never reverses → 0 turning points.
test "a monotone row has zero turning points" {
  let x = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let y = turning_point_count_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// zigzag [1,3,2,4]: a peak at index 1 and a trough at index 2 → 2 turning points.
test "a zigzag row counts each direction reversal" {
  let x = matrix.from_lists([[1.0, 3.0, 2.0, 4.0]])
  let y = turning_point_count_rows(x)
  assert_eq(matrix.get(y, 0, 0), 2.0)
}
