// sigmoid_act — standard logistic sigmoid: 1/(1+exp(-x)). Bounded in (0,1).
// Elementwise. (Standalone activation op; the matrix stdlib has no bare sigmoid.)

import math

fn sigmoid_act(m: Matrix) -> Matrix =
  matrix.map(m, (x) => 1.0 / (1.0 + math.exp(0.0 - x)))

test "sigmoid at zero is half" {
  let y = sigmoid_act(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.5)
}

test "sigmoid saturates to 0 and 1" {
  let y = sigmoid_act(matrix.from_lists([[30.0, -30.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "→ 1")
  assert(float.abs(matrix.get(y, 0, 1)) < 0.000000001, "→ 0")
}
