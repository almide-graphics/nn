// l2_dist_rows — row-wise Euclidean (L2) distance of two matrices:
//
//   dist_r = √( Σ_j (a_rj − b_rj)² )
//
// One value per row → output (T,1). The straight-line distance (sum, not mean,
// under the root — distinct from mse_rows); k-NN / metric-learning building
// block. Two-input row reduction.

import math

fn l2_dist_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, _) = matrix.shape(a)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let an = list.get_or(ra, n, [])
    let bn = list.get_or(rb, n, [])
    let ss = list.zip_with(an, bn, (x, y) => (x - y) * (x - y)) |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[math.sqrt(ss)]]
    n = n + 1
  }
  matrix.from_lists(out)
}

// dist(a, a) = 0.
test "l2 distance of identical rows is zero" {
  let a = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let y = l2_dist_rows(a, a)
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// 3-4-5: √(3²+4²) = 5.
test "l2 distance of zero to three-four is five" {
  let a = matrix.from_lists([[0.0, 0.0]])
  let b = matrix.from_lists([[3.0, 4.0]])
  let y = l2_dist_rows(a, b)
  assert_eq(matrix.get(y, 0, 0), 5.0)
}
