// squared_diff_rows — squared first difference over time (down the rows):
//   out_0 = 0,   out_t = (x_t − x_{t-1})²   (t ≥ 1).
// The per-step change energy: the squared velocity of each channel, summed over time it
// gives the discrete Dirichlet energy / a smoothness penalty (large where the sequence
// jumps, zero where it holds). The L2 companion of abs_diff. Carries the previous row
// forward and squares the change. Row 0 has no predecessor, so it is 0. Output (T,D).

fn squared_diff_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  let zero = list.range(0, d) |> list.map((_) => 0.0)
  var prev: List[Float] = list.get_or(rx, 0, [])
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    let row = if i == 0 then zero else list.zip_with(prev, xi, (p, c) => (c - p) * (c - p))
    out = out + [row]
    prev = xi
    i = i + 1
  }
  matrix.from_lists(out)
}

// column 0 = [3,7,2]: (7−3)²=16, (2−7)²=25.
test "squared-diff is the squared step-to-step change" {
  let x = matrix.from_lists([[3.0], [7.0], [2.0]])
  let y = squared_diff_rows(x)
  assert_eq(matrix.get(y, 0, 0), 0.0)
  assert_eq(matrix.get(y, 1, 0), 16.0)
  assert_eq(matrix.get(y, 2, 0), 25.0)
}

// a constant column has zero change energy.
test "squared-diff is zero on a constant column" {
  let x = matrix.from_lists([[4.0], [4.0], [4.0]])
  let y = squared_diff_rows(x)
  assert_eq(matrix.get(y, 1, 0), 0.0)
  assert_eq(matrix.get(y, 2, 0), 0.0)
}
