// soft_exactly_two3_rows — the differentiable "exactly two of three" gate, elementwise (3-input):
//   out = a·b·(1−c) + a·(1−b)·c + (1−a)·b·c   for a, b, c ∈ [0,1]   → (T,D).
// Reading a, b, c as independent Bernoulli probabilities, this is P(exactly two of the three are on)
// — the count-class {2} symmetric Boolean function. With this gate the count-indexed symmetric
// family on three inputs is complete up to complement: majority {2,3}, parity {1,3}, consensus
// {0,3}, exactly_one {1}, and exactly_two {2} together span the non-complementary symmetric gates
// (the remaining count sets are their 1−g complements, the trivial AND3 {3}, or constants). At the
// boolean corners it fires iff exactly two inputs are on; at a=b=c=½ it is ⅜. Symmetric. Output (T,D).

import float

fn soft_exactly_two3_rows(a: Matrix, b: Matrix, c: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let rc = matrix.to_lists(c)
  let (t, d) = matrix.shape(a)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let ci = list.get_or(rc, i, [])
    var row: List[Float] = []
    var j = 0
    while j < d {
      let av = list.get_or(ai, j, 0.0)
      let bv = list.get_or(bi, j, 0.0)
      let cv = list.get_or(ci, j, 0.0)
      row = row + [av * bv * (1.0 - cv)
                 + av * (1.0 - bv) * cv
                 + (1.0 - av) * bv * cv]
      j = j + 1
    }
    out = out + [row]
    i = i + 1
  }
  matrix.from_lists(out)
}

// fires iff exactly two are on: (1,1,0)→1, (1,0,1)→1, (1,1,1)→0.
test "soft-exactly-two-3 is 1 iff exactly two inputs are on (corners)" {
  let a = matrix.from_lists([[1.0, 1.0, 1.0]])
  let b = matrix.from_lists([[1.0, 0.0, 1.0]])
  let c = matrix.from_lists([[0.0, 1.0, 1.0]])
  let y = soft_exactly_two3_rows(a, b, c)
  assert_eq(matrix.get(y, 0, 0), 1.0)
  assert_eq(matrix.get(y, 0, 1), 1.0)
  assert_eq(matrix.get(y, 0, 2), 0.0)
}

// at a = b = c = ½: 3·(½·½·½) = ⅜.
test "soft-exactly-two-3 at p=0.5 is three eighths" {
  let a = matrix.from_lists([[0.5]])
  let b = matrix.from_lists([[0.5]])
  let c = matrix.from_lists([[0.5]])
  let y = soft_exactly_two3_rows(a, b, c)
  assert(float.abs(matrix.get(y, 0, 0) - 0.375) < 0.000000001, "0.375")
}
