// gaussian — RBF / Gaussian activation: exp(-x²). Bell-shaped, peaks at 0.
// Used in RBF networks and as a locality kernel. Elementwise.

import math

fn gaussian(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - x * x))

test "gaussian at zero is one" {
  let y = gaussian(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

test "gaussian at one is exp(-1)" {
  let y = gaussian(matrix.from_lists([[1.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "e^-1")
}
