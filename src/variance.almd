// variance_rows — population variance of each row → (T,1):
//   var_r = mean_j (x_rj - mean_r)²
// Two-pass (mean, then squared deviations). The dispersion stat behind
// layer-norm / whitening.

fn variance_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  let df = int.to_float(d)
  var out: List[List[Float]] = []
  var n = 0
  while n < t {
    let xn = list.get_or(rx, n, [])
    let mean = (xn |> list.fold(0.0, (acc, v) => acc + v)) / df
    let sq = xn |> list.fold(0.0, (acc, v) => acc + (v - mean) * (v - mean))
    out = out + [[sq / df]]
    n = n + 1
  }
  matrix.from_lists(out)
}

// Constant row → zero variance.
test "variance of constant row is zero" {
  let y = variance_rows(matrix.from_lists([[5.0, 5.0, 5.0, 5.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// [1,2,3] → mean 2 → var = (1+0+1)/3 = 2/3.
test "variance is population variance" {
  let y = variance_rows(matrix.from_lists([[1.0, 2.0, 3.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.6666666666666666) < 0.000000001, "2/3")
}
