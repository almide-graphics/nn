// exp_neg_quad_shift — exp(-(x-2)²). A Gaussian RBF centered at 2: peaks at 1,
// symmetric about its center. Extends the RBF basis (centers at -1, 1, 2) for
// covering activations away from the origin. Elementwise.

import math

fn exp_neg_quad_shift(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - (x - 2.0) * (x - 2.0)))

test "exp_neg_quad_shift peaks at one when x=2" {
  let y = exp_neg_quad_shift(matrix.from_lists([[2.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// symmetric about x=2: values at 1 and 3 are both exp(-1).
test "exp_neg_quad_shift symmetric about two" {
  let y = exp_neg_quad_shift(matrix.from_lists([[1.0, 3.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "e⁻¹")
  assert(float.abs(matrix.get(y, 0, 1) - 0.36787944117144233) < 0.000000001, "sym")
}
