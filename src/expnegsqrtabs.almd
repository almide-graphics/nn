// exp_neg_sqrt_abs — exp(-√|x|). A sub-exponential bump: even, peaks at 1, with
// a sharp cusp at 0 and heavier tails than the Laplace kernel (sub-Gaussian
// decay). Useful for very-heavy-tailed localization. Elementwise.

import math

fn exp_neg_sqrt_abs(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - math.sqrt(float.abs(x))))

test "exp_neg_sqrt_abs peaks at one when x=0" {
  let y = exp_neg_sqrt_abs(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// exp(-√1)=exp(-1) at x=1; even.
test "exp_neg_sqrt_abs at 1 and even" {
  let y = exp_neg_sqrt_abs(matrix.from_lists([[1.0, -1.0]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "e⁻¹")
  assert(float.abs(matrix.get(y, 0, 1) - 0.36787944117144233) < 0.000000001, "even")
}
