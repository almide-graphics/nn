// exp_neg_three_sq — exp(-3x²). A tighter Gaussian RBF (precision γ=3, σ²=⅙):
// even, peaks at 1, narrower than exp(-2x²). Extends the precision family for
// fine-grained localization. Elementwise.

import math

fn exp_neg_three_sq(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.exp(0.0 - 3.0 * x * x))

test "exp_neg_three_sq peaks at one when x=0" {
  let y = exp_neg_three_sq(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// 3·(1/√3)²=1 → exp(-1) at x=1/√3; even.
test "exp_neg_three_sq at one over sqrt3 and even" {
  let y = exp_neg_three_sq(matrix.from_lists([[0.5773502691896257, -0.5773502691896257]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.36787944117144233) < 0.000000001, "e⁻¹")
  assert(float.abs(matrix.get(y, 0, 1) - 0.36787944117144233) < 0.000000001, "even")
}
