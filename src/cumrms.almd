// cumrms_rows — cumulative root-mean-square over time (down the rows, per channel):
//   out_t = sqrt( (1/(t+1)) Σ_{i≤t} x_i² )   (elementwise per channel).
// The running (uncentered) RMS of a sequence — the streaming RMSNorm scale a channel would
// track as samples arrive. Distinct from cumstd_rows / cumvar_rows (which center by the running
// mean) and from cummean_abs_rows (an L1 running average); this is the expanding-window L2 root
// about zero. One running sum-of-squares accumulator, divided by the count and rooted each step.
// O(T), O(D) state. Output (T,D).

import math

fn cumrms_rows(x: Matrix) -> Matrix = {
  let rx = matrix.to_lists(x)
  let (t, d) = matrix.shape(x)
  var acc: List[Float] = list.range(0, d) |> list.map((_) => 0.0)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let xi = list.get_or(rx, i, [])
    acc = list.zip_with(acc, xi, (a, v) => a + v * v)
    let n = int.to_float(i + 1)
    out = out + [acc |> list.map((s) => math.sqrt(s / n))]
    i = i + 1
  }
  matrix.from_lists(out)
}

// first row is |x_0| (RMS of one sample): column [3,...] → out_0 = 3.
test "cumulative rms of the first sample is its magnitude" {
  let x = matrix.from_lists([[3.0], [0.0 - 4.0]])
  let y = cumrms_rows(x)
  assert(float.abs(matrix.get(y, 0, 0) - 3.0) < 0.000000001, "sqrt(9)=3")
}

// column [3,−4]: out_1 = sqrt((9+16)/2) = sqrt(12.5).
test "cumulative rms is the expanding-window root mean square" {
  let x = matrix.from_lists([[3.0], [0.0 - 4.0]])
  let y = cumrms_rows(x)
  assert(float.abs(matrix.get(y, 1, 0) - math.sqrt(12.5)) < 0.000000001, "sqrt(12.5)")
}
