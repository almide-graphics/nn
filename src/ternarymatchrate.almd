// ternary_match_rate_rows — per-row fraction of agreeing TWN ternary codes of two matrices.
//   Δa_t = 0.7·(1/D)Σ_j|a_{t,j}|,  Δb_t = 0.7·(1/D)Σ_j|b_{t,j}|   (each row's own threshold)
//   code(x,Δ) = +1 if x>Δ ; −1 if x<−Δ ; 0 otherwise
//   out_t = (1/D) Σ_j [ code(a)=code(b) ]                → one fraction per row, (T,1).
// The ternary analogue of sign_match_rate_rows: once both rows are TWN-quantized to {−1,0,1}
// against their own 0.7·E|x| cut, how many positions land on the same code — agreement that,
// unlike the sign version, also rewards both sides falling in the dead-zone (a shared
// "pruned" weight). A scale-free read of how similarly two tensors ternarize (1 = identical
// codes). Codes are exact integers, compared by |cu−cv|<0.5. Two-input row reduction. (T,1).

import float

fn ternary_match_rate_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, d) = matrix.shape(a)
  let df = int.to_float(d)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let da = 0.7 * ((ai |> list.fold(0.0, (acc, v) => acc + float.abs(v))) / df)
    let db = 0.7 * ((bi |> list.fold(0.0, (acc, v) => acc + float.abs(v))) / df)
    let agree = list.zip_with(ai, bi, (u, v) => {
      let cu = if u > da then 1.0 else (if u < (0.0 - da) then 0.0 - 1.0 else 0.0)
      let cv = if v > db then 1.0 else (if v < (0.0 - db) then 0.0 - 1.0 else 0.0)
      if float.abs(cu - cv) < 0.5 then 1.0 else 0.0
    }) |> list.fold(0.0, (acc, p) => acc + p)
    out = out + [[agree / df]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a matrix ternarizes identically to itself → every code agrees → rate 1.
test "ternary-match-rate of a matrix with itself is one" {
  let a = matrix.from_lists([[3.0, 0.0 - 4.0, 0.1, 2.0]])
  let y = ternary_match_rate_rows(a, a)
  assert(float.abs(matrix.get(y, 0, 0) - 1.0) < 0.000000001, "self → 1")
}

// a → codes [+1,−1,0] (Δa≈1.657); b all-large-positive → [+1,+1,+1]; agree only at pos 0 → 1/3.
test "ternary-match-rate counts agreeing codes, dead-zone aware" {
  let a = matrix.from_lists([[3.0, 0.0 - 4.0, 0.1]])
  let b = matrix.from_lists([[5.0, 5.0, 5.0]])
  let y = ternary_match_rate_rows(a, b)
  assert(float.abs(matrix.get(y, 0, 0) - 0.3333333333333333) < 0.000000001, "1/3")
}
