// proj_scalar_rows — scalar projection of a onto b, per row:
//   out_t = ⟨a_t, b_t⟩ / (‖b_t‖ + ε)                   → one value per row, (T,1).
// The signed length of a's component along b (a·b̂): the building block of Gram–Schmidt and of
// gradient-surgery methods like PCGrad (project one gradient onto another). Distinct from
// dot_rows (the raw ⟨a,b⟩) and cosine_sim_rows (⟨a,b⟩/(‖a‖‖b‖)) — here only b is normalized, so
// the result has the units/scale of a. proj(a,a)=‖a‖; proj(a,b)=a_b when b is an axis. The +ε
// guards a zero b. Two-input row reduction. Output (T,1).

import float
import math

fn proj_scalar_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, _) = matrix.shape(a)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let dot = list.zip_with(ai, bi, (x, y) => x * y) |> list.fold(0.0, (acc, v) => acc + v)
    let nb = math.sqrt(bi |> list.fold(0.0, (acc, v) => acc + v * v))
    out = out + [[dot / (nb + 0.000000000001)]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// projecting [3,4] onto the x-axis [1,0] gives its x-component 3.
test "scalar projection onto an axis is the matching component" {
  let a = matrix.from_lists([[3.0, 4.0]])
  let b = matrix.from_lists([[1.0, 0.0]])
  let y = proj_scalar_rows(a, b)
  assert(float.abs(matrix.get(y, 0, 0) - 3.0) < 0.000000001, "proj of [3,4] onto x = 3")
}

// projecting a onto itself yields its norm: ‖[3,4]‖ = 5.
test "scalar projection of a onto itself is its norm" {
  let a = matrix.from_lists([[3.0, 4.0]])
  let y = proj_scalar_rows(a, a)
  assert(float.abs(matrix.get(y, 0, 0) - 5.0) < 0.000000001, "proj a onto a = 5")
}
