// binary_dot_rows — row-wise binary inner product of two matrices' signs.
//   out_t = Σ_j sign(a_{t,j}) · sign(b_{t,j})        → one value per row, (T,1).
// The BitNet "beyond matmul" primitive: once both operands are binarized to {−1,+1},
// a dot product is just (#sign-agreements − #disagreements), i.e. a popcount — no
// multipliers. This op is that integer score per row (agreements counted +1, opposers
// −1, zeros contribute 0). math.sign is Int-only, so each sign is the ±1/0 threshold;
// the per-row sum folds the sign products. Two-input row reduction. Output (T,1).

fn binary_dot_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (t, _) = matrix.shape(a)
  var out: List[List[Float]] = []
  var i = 0
  while i < t {
    let ai = list.get_or(ra, i, [])
    let bi = list.get_or(rb, i, [])
    let prods = list.zip_with(ai, bi, (u, v) => {
      let su = if u > 0.0 then 1.0 else (if u < 0.0 then 0.0 - 1.0 else 0.0)
      let sv = if v > 0.0 then 1.0 else (if v < 0.0 then 0.0 - 1.0 else 0.0)
      su * sv
    })
    let dot = prods |> list.fold(0.0, (acc, p) => acc + p)
    out = out + [[dot]]
    i = i + 1
  }
  matrix.from_lists(out)
}

// a=[+,+,−,−], b=[+,−,−,+]: products [+1,−1,+1,−1] → sum 0.
test "binary-dot sums sign agreements minus disagreements" {
  let a = matrix.from_lists([[1.0, 2.0, 0.0 - 3.0, 0.0 - 4.0]])
  let b = matrix.from_lists([[5.0, 0.0 - 6.0, 0.0 - 7.0, 8.0]])
  let y = binary_dot_rows(a, b)
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// a binary row dotted with itself counts its nonzeros: [+,−,+] → 3.
test "binary-dot of a row with itself counts its support" {
  let a = matrix.from_lists([[2.0, 0.0 - 1.0, 9.0]])
  let y = binary_dot_rows(a, a)
  assert_eq(matrix.get(y, 0, 0), 3.0)
}
