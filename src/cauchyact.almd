// cauchy_act — 1/(1+x²). The Cauchy/Lorentzian bump: peaks at 1, even, with
// heavy (power-law) tails. An exp-free localized RBF. Elementwise.

fn cauchy_act(m: Matrix) -> Matrix =
  matrix.map(m, (x) => 1.0 / (1.0 + x * x))

test "cauchy_act peaks at one when x=0" {
  let y = cauchy_act(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// 1/(1+1)=0.5 and even.
test "cauchy_act at 1 and even" {
  let y = cauchy_act(matrix.from_lists([[1.0, -1.0]]))
  assert_eq(matrix.get(y, 0, 0), 0.5)
  assert_eq(matrix.get(y, 0, 1), 0.5)
}
