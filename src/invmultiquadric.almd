// inv_multiquadric — 1/√(1+x²). The inverse multiquadric RBF: even, peaks at 1,
// bounded in (0,1] with algebraic (power-law) tails. Elementwise.

import math

fn inv_multiquadric(m: Matrix) -> Matrix =
  matrix.map(m, (x) => 1.0 / math.sqrt(1.0 + x * x))

test "inv_multiquadric at zero is one" {
  let y = inv_multiquadric(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

// 1/√(1+3)=0.5 at x=√3; even.
test "inv_multiquadric at sqrt3 is half and even" {
  let y = inv_multiquadric(matrix.from_lists([[1.7320508075688772, -1.7320508075688772]]))
  assert(float.abs(matrix.get(y, 0, 0) - 0.5) < 0.000000001, "= 0.5")
  assert(float.abs(matrix.get(y, 0, 1) - 0.5) < 0.000000001, "even")
}
