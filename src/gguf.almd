// nn.gguf — GGUF model file parser
//
// Reads tensor metadata and weight data from GGUF files (whisper.cpp format).
// Supports F32 and F16 data types. Quantized types return raw bytes for now.
//
// GGUF spec: https://github.com/ggml-org/ggml/blob/master/docs/gguf.md

import fs
import math

// ── Types ──

type GGUFHeader = {
  version: Int,
  tensor_count: Int,
  metadata_count: Int,
}

type GGUFMetadata = {
  entries: List[(String, GGUFValue)],
}

type GGUFValue =
  | ValInt(Int)
  | ValFloat(Float)
  | ValBool(Bool)
  | ValString(String)
  | ValArray(List[GGUFValue])

type TensorInfo = {
  name: String,
  dims: List[Int],
  dtype: Int,
  offset: Int,
}

type GGUFFile = {
  header: GGUFHeader,
  metadata: GGUFMetadata,
  tensors: List[TensorInfo],
  data_offset: Int,
  raw: Bytes,
}

// ── Binary reading helpers ──

fn r_u8(data: Bytes, pos: Int) -> Int =
  int.band(bytes.get(data, pos) ?? 0, 255)

fn r_u32(data: Bytes, pos: Int) -> Int =
  r_u8(data, pos) + r_u8(data, pos + 1) * 256 +
  r_u8(data, pos + 2) * 65536 + r_u8(data, pos + 3) * 16777216

fn r_u64(data: Bytes, pos: Int) -> Int =
  r_u32(data, pos) + r_u32(data, pos + 4) * 4294967296

fn r_i32(data: Bytes, pos: Int) -> Int = {
  let raw = r_u32(data, pos)
  if raw >= 2147483648 then raw - 4294967296 else raw
}

fn r_f32(data: Bytes, pos: Int) -> Float =
  int.bits_to_f32(r_u32(data, pos))

fn r_string(data: Bytes, pos: Int) -> (String, Int) = {
  let len = r_u64(data, pos)
  let raw = bytes.to_list(bytes.slice(data, pos + 8, pos + 8 + len))
  (string.from_bytes(raw), pos + 8 + len)
}

// ── GGUF value type enum ──
// 0=UINT8, 1=INT8, 2=UINT16, 3=INT16, 4=UINT32, 5=INT32,
// 6=FLOAT32, 7=BOOL, 8=STRING, 9=ARRAY, 10=UINT64, 11=INT64, 12=FLOAT64

// Non-array scalar value reader. Pure: only reads through stdlib helpers
// that take `&Bytes`, so Almide codegen can pass `data` by reference
// (no clone). This is the hot path inside read_array.
fn read_scalar_value(data: Bytes, pos: Int, vtype: Int) -> (GGUFValue, Int) =
  if vtype == 4 or vtype == 5 or vtype == 0 or vtype == 1 or vtype == 2 or vtype == 3 then
    (ValInt(r_i32(data, pos)), pos + 4)
  else if vtype == 10 or vtype == 11 then
    (ValInt(r_u64(data, pos)), pos + 8)
  else if vtype == 6 then
    (ValFloat(r_f32(data, pos)), pos + 4)
  else if vtype == 12 then
    (ValFloat(r_f32(data, pos)), pos + 8)
  else if vtype == 7 then
    (ValBool(r_u8(data, pos) != 0), pos + 1)
  else if vtype == 8 then {
    let (s, next) = r_string(data, pos)
    (ValString(s), next)
  }
  else (ValInt(0), pos + 4)

fn read_value(data: Bytes, pos: Int, vtype: Int) -> (GGUFValue, Int) =
  if vtype == 9 then {
    let arr_type = r_u32(data, pos)
    let arr_count = r_u64(data, pos + 4)
    read_array(data, pos + 12, arr_type, arr_count)
  }
  else read_scalar_value(data, pos, vtype)

// Qwen3-class GGUF tokenizer metadata has 150k+ element arrays, so the
// original recursive form overflowed the stack on real models. Because
// this function uses `var`/`list.push`, Almide codegen promotes `data`
// to an owned Vec<u8> — so EVERY caller must pay a 248 MB clone to
// invoke us. The callers above (read_value, parse_metadata_entries)
// ensure this cost is amortised: read_array is only invoked once per
// array-valued metadata entry (3 times for typical Qwen3 GGUF files),
// not once per array element. Inside the loop we call `read_scalar_value`
// which stays pass-by-reference.
// Cap on the number of values we retain per metadata array. Beyond
// this, read_array still walks the source bytes to keep `pos` correct
// (so downstream tensor-info offsets line up) but drops the values on
// the floor. This matters on targets where `list.push` cannot reclaim
// the growing Vec's old storage — notably WASM, whose bump allocator
// keeps every prior re-allocation alive and would OOM on a 150 k-entry
// Qwen3 tokenizer array. Inference-time code never needs these values;
// callers that do (tokenizer bootstrap) can raise the limit.
fn array_retain_limit() -> Int = 2048

fn read_array(data: Bytes, pos: Int, vtype: Int, count: Int) -> (GGUFValue, Int) = {
  var items: List[GGUFValue] = []
  var p = pos
  let limit = array_retain_limit()
  var retained = 0
  for _ in 0..count {
    if vtype == 9 then {
      let arr_type = r_u32(data, p)
      let arr_count = r_u64(data, p + 4)
      let (val, next) = read_array(data, p + 12, arr_type, arr_count)
      if retained < limit then {
        list.push(items, val)
        retained = retained + 1
      }
      p = next
    } else {
      let (val, next) = read_scalar_value(data, p, vtype)
      if retained < limit then {
        list.push(items, val)
        retained = retained + 1
      }
      p = next
    }
  }
  (ValArray(items), p)
}

// ── Header parsing ──

effect fn parse_header(data: Bytes) -> Result[(GGUFHeader, Int), String] = {
  let magic = r_u32(data, 0)
  if magic != 1179993927 then err("not a GGUF file (bad magic)")
  else {
    let version = r_u32(data, 4)
    let tensor_count = r_u64(data, 8)
    let metadata_count = r_u64(data, 16)
    ok((GGUFHeader {
      version: version,
      tensor_count: tensor_count,
      metadata_count: metadata_count,
    }, 24))
  }
}

// ── Metadata parsing ──

fn parse_metadata_entries(data: Bytes, pos: Int, count: Int) -> (List[(String, GGUFValue)], Int) = {
  var entries: List[(String, GGUFValue)] = []
  var p = pos
  for _ in 0..count {
    let (key, after_key) = r_string(data, p)
    let vtype = r_u32(data, after_key)
    let value_pos = after_key + 4
    // Dispatch inline: array values call read_array directly (one 248 MB
    // clone per big array — 3 total for Qwen3); scalars go through
    // read_scalar_value which takes `&Bytes` (no clone).
    let (value, after_value) = if vtype == 9 then {
      let arr_type = r_u32(data, value_pos)
      let arr_count = r_u64(data, value_pos + 4)
      read_array(data, value_pos + 12, arr_type, arr_count)
    } else {
      read_scalar_value(data, value_pos, vtype)
    }
    list.push(entries, (key, value))
    p = after_value
  }
  (entries, p)
}

// ── Tensor info parsing ──

fn parse_tensor_infos(data: Bytes, pos: Int, count: Int) -> (List[TensorInfo], Int) = {
  var tensors: List[TensorInfo] = []
  var p = pos
  for _ in 0..count {
    let (name, after_name) = r_string(data, p)
    let n_dims = r_u32(data, after_name)
    // Explicit for-loop over dims rather than `list.map` with a capturing
    // closure. The closure would capture `data` by value (owning the
    // 248 MB Bytes), producing one per-tensor clone — 310 tensors × 248 MB
    // = 77 GB of redundant copies during a single GGUF parse.
    var dims: List[Int] = []
    for i in 0..n_dims {
      list.push(dims, r_u64(data, after_name + 4 + i * 8))
    }
    let after_dims = after_name + 4 + n_dims * 8
    let dtype = r_u32(data, after_dims)
    let offset = r_u64(data, after_dims + 4)
    list.push(tensors, TensorInfo { name: name, dims: dims, dtype: dtype, offset: offset })
    p = after_dims + 12
  }
  (tensors, p)
}

// ── Alignment ──

fn align_to(pos: Int, alignment: Int) -> Int = {
  let remainder = pos % alignment
  if remainder == 0 then pos else pos + alignment - remainder
}

fn get_alignment(metadata: List[(String, GGUFValue)]) -> Int =
  list.find(metadata, (entry) => entry.0 == "general.alignment")
    |> option.map((entry) => match entry.1 {
      ValInt(n) => n
      _ => 32
    })
    |> option.unwrap_or(32)

// ── Full file parsing ──

effect fn parse(data: Bytes) -> Result[GGUFFile, String] =
  match parse_header(data) {
    err(e) => err(e)
    ok(header_result) => {
      let (header, pos) = header_result
      let (meta_entries, after_meta) = parse_metadata_entries(data, pos, header.metadata_count)
      let (tensor_infos, after_tensors) = parse_tensor_infos(data, after_meta, header.tensor_count)
      let alignment = get_alignment(meta_entries)
      let data_start = align_to(after_tensors, alignment)
      ok(GGUFFile {
        header: header,
        metadata: GGUFMetadata { entries: meta_entries },
        tensors: tensor_infos,
        data_offset: data_start,
        raw: data,
      })
    }
  }

effect fn load(path: String) -> Result[GGUFFile, String] =
  match fs.read_bytes(path) {
    err(e) => err("failed to read " + path + ": " + e)
    ok(raw) => parse(bytes.from_list(raw))
  }

// ── Tensor data extraction ──

fn tensor_element_size(dtype: Int) -> Int =
  if dtype == 0 then 4      // F32
  else if dtype == 1 then 2  // F16
  else 1                     // unknown: return 1 byte

fn tensor_num_elements(info: TensorInfo) -> Int =
  list.fold(info.dims, 1, (acc, d) => acc * d)

fn extract_f32_tensor(file: GGUFFile, info: TensorInfo) -> List[Float] = {
  let start = file.data_offset + info.offset
  let count = tensor_num_elements(info)
  // Explicit imperative read: the previous `list.map((i) => r_f32(file.raw, ...))`
  // generated a closure that captured the whole GGUFFile and called
  // `__cap.clone().raw` each iteration — 248 MB × count memcpy per tensor.
  // Binding `data = file.raw` once and looping with `list.push` keeps
  // the inner body reference-only on `data`.
  let data = file.raw
  var out: List[Float] = list.with_capacity(count)
  for i in 0..count {
    list.push(out, r_f32(data, start + i * 4))
  }
  out
}

fn extract_f32_matrix(file: GGUFFile, info: TensorInfo) -> Matrix = {
  let values = extract_f32_tensor(file, info)
  if list.len(info.dims) == 2 then {
    let rows = list.get(info.dims, 0) |> option.unwrap_or(1)
    let cols = list.get(info.dims, 1) |> option.unwrap_or(list.len(values))
    let row_lists = list.range(0, rows) |> list.map((r) =>
      list.slice(values, r * cols, (r + 1) * cols)
    )
    matrix.from_lists(row_lists)
  } else {
    // 1D: single-row matrix
    matrix.from_lists([values])
  }
}

// ── Q1_0 quantization (PrismML Bonsai; dtype = 41) ──
//
// Block layout: 18 bytes per 128 weights.
//   bytes[0..2]   = fp16 scale (little-endian)
//   bytes[2..18]  = 16 bytes of sign bits; 128 bits total, LSB-first
//                   within each byte. Bit 0 → -scale, bit 1 → +scale.
// Effective 1.125 bits/weight (1 sign bit + 16-bit scale amortised
// over 128 weights).

fn q1_0_block_size() -> Int = 18
fn q1_0_values_per_block() -> Int = 128

// Decode one Q1_0 block starting at `block_start`. Returns (scale, 128 weights).
// Pure read on `data` — safe to call once per block.
fn decode_q1_0_block(data: Bytes, block_start: Int) -> (Float, List[Float]) = {
  let scale_raw = r_u8(data, block_start) + r_u8(data, block_start + 1) * 256
  let scale = f16_to_f32(scale_raw)
  let neg_scale = 0.0 - scale
  let bits_start = block_start + 2
  var weights: List[Float] = []
  for i in 0..128 {
    let byte_idx = bits_start + i / 8
    let bit_offset = i - (i / 8) * 8
    let byte_val = r_u8(data, byte_idx)
    let bit = int.band(int.bshr(byte_val, bit_offset), 1)
    list.push(weights, if bit == 1 then scale else neg_scale)
  }
  (scale, weights)
}

fn extract_q1_0_tensor(file: GGUFFile, info: TensorInfo) -> List[Float] = {
  let start = file.data_offset + info.offset
  let total = tensor_num_elements(info)
  let num_blocks = total / 128
  // Pre-size the output Vec to exact final length so the 2M inner pushes
  // skip ~21 Vec-doubling reallocations per tensor. Major Q1_0 decode win.
  var out: List[Float] = list.with_capacity(total)
  for b in 0..num_blocks {
    let block_start = start + b * 18
    let scale_raw = r_u8(file.raw, block_start) + r_u8(file.raw, block_start + 1) * 256
    let scale = f16_to_f32(scale_raw)
    let neg_scale = 0.0 - scale
    let bits_start = block_start + 2
    for i in 0..128 {
      let byte_idx = bits_start + i / 8
      let bit_offset = i - (i / 8) * 8
      let byte_val = r_u8(file.raw, byte_idx)
      let bit = int.band(int.bshr(byte_val, bit_offset), 1)
      list.push(out, if bit == 1 then scale else neg_scale)
    }
  }
  out
}

fn extract_q1_0_matrix(file: GGUFFile, info: TensorInfo) -> Matrix = {
  // GGUF dims are [in, out] for weights; linear_row_no_bias wants
  // weight[out_rows, in_cols], so unpack cols=dims[0], rows=dims[1].
  // For 1-D tensors (no dims[1]) we fall back to row=1 with full length.
  let cols = list.get(info.dims, 0) |> option.unwrap_or(1)
  let rows = list.get(info.dims, 1) |> option.unwrap_or(1)
  let offset = file.data_offset + info.offset
  // Direct bulk decode via the matrix primitive — ~100x faster than
  // pushing one value at a time through the Almide runtime.
  matrix.from_q1_0_bytes(file.raw, offset, rows, cols)
}

// ── F16 → F32 conversion ──

fn f16_to_f32(raw: Int) -> Float = {
  let sign = int.band(int.bshr(raw, 15), 1)
  let exponent = int.band(int.bshr(raw, 10), 31)
  let mantissa = int.band(raw, 1023)
  if exponent == 0 then {
    // Subnormal
    let val = int.to_float(mantissa) / 1024.0 * math.fpow(2.0, -14.0)
    if sign == 1 then 0.0 - val else val
  } else if exponent == 31 then {
    // Inf/NaN → approximate as large float
    if sign == 1 then -99999.0 else 99999.0
  } else {
    let val = (1.0 + int.to_float(mantissa) / 1024.0) * math.fpow(2.0, int.to_float(exponent) - 15.0)
    if sign == 1 then 0.0 - val else val
  }
}

fn extract_f16_tensor(file: GGUFFile, info: TensorInfo) -> List[Float] = {
  let start = file.data_offset + info.offset
  let count = tensor_num_elements(info)
  list.range(0, count) |> list.map((i) => {
    let raw = r_u8(file.raw, start + i * 2) + r_u8(file.raw, start + i * 2 + 1) * 256
    f16_to_f32(raw)
  })
}

// ── Lookup helpers ──

fn find_tensor(file: GGUFFile, name: String) -> Option[TensorInfo] =
  list.find(file.tensors, (t) => t.name == name)

fn get_metadata_string(file: GGUFFile, key: String) -> Option[String] =
  list.find(file.metadata.entries, (e) => e.0 == key)
    |> option.flat_map((e) => match e.1 {
      ValString(s) => some(s)
      _ => none
    })

fn get_metadata_int(file: GGUFFile, key: String) -> Option[Int] =
  list.find(file.metadata.entries, (e) => e.0 == key)
    |> option.flat_map((e) => match e.1 {
      ValInt(n) => some(n)
      _ => none
    })

// ── Tests ──

fn approx(a: Float, b: Float) -> Bool =
  float.abs(a - b) < 0.01

test "r_u32 little endian" {
  let b = bytes.from_list([0x47, 0x47, 0x55, 0x46])
  assert_eq(r_u32(b, 0), 1179993927)  // "GGUF" magic
}

test "r_string" {
  let b = bytes.from_list([5, 0, 0, 0, 0, 0, 0, 0, 104, 101, 108, 108, 111])
  let (s, next) = r_string(b, 0)
  assert_eq(s, "hello")
  assert_eq(next, 13)
}

test "f16_to_f32 zero" {
  assert(approx(f16_to_f32(0), 0.0))
}

test "f16_to_f32 one" {
  // F16 encoding of 1.0: sign=0, exp=15, mantissa=0 → 0b0_01111_0000000000 = 0x3C00
  assert(approx(f16_to_f32(0x3C00), 1.0))
}

test "f16_to_f32 negative one" {
  // F16 encoding of -1.0: sign=1, exp=15, mantissa=0 → 0b1_01111_0000000000 = 0xBC00
  assert(approx(f16_to_f32(0xBC00), -1.0))
}

test "f16_to_f32 half" {
  // F16 encoding of 0.5: sign=0, exp=14, mantissa=0 → 0b0_01110_0000000000 = 0x3800
  assert(approx(f16_to_f32(0x3800), 0.5))
}

test "align_to" {
  assert_eq(align_to(100, 32), 128)
  assert_eq(align_to(128, 32), 128)
  assert_eq(align_to(0, 32), 0)
}

test "tensor_num_elements" {
  let info = TensorInfo { name: "test", dims: [3, 4], dtype: 0, offset: 0 }
  assert_eq(tensor_num_elements(info), 12)
}

test "parse minimal gguf header" {
  // Build a minimal GGUF v3 header: magic + version + 0 tensors + 0 metadata
  let data = bytes.from_list([
    0x47, 0x47, 0x55, 0x46,  // "GGUF"
    3, 0, 0, 0,               // version 3
    0, 0, 0, 0, 0, 0, 0, 0,  // tensor_count = 0
    0, 0, 0, 0, 0, 0, 0, 0,  // metadata_count = 0
  ])
  match parse_header(data) {
    ok(result) => {
      let (header, pos) = result
      assert_eq(header.version, 3)
      assert_eq(header.tensor_count, 0)
      assert_eq(header.metadata_count, 0)
      assert_eq(pos, 24)
    }
    err(e) => { println("error: " + e); assert(false) }
  }
}
