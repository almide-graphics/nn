// rmse_rows — row-wise root mean squared error of two matrices:
//
//   rmse_r = √( (1/D) · Σ_j (a_rj − b_rj)² )
//
// One value per row → output (T,1). The error in the same units as the targets
// (√ of mse_rows; differs from l2_dist_rows by the 1/D under the root). Two-input
// row reduction.

import math

fn rmse_rows(a: Matrix, b: Matrix) -> Matrix = {
  let ra = matrix.to_lists(a)
  let rb = matrix.to_lists(b)
  let (rows, d) = matrix.shape(a)
  let df = int.to_float(d)
  var out: List[List[Float]] = []
  var n = 0
  while n < rows {
    let an = list.get_or(ra, n, [])
    let bn = list.get_or(rb, n, [])
    let sse = list.zip_with(an, bn, (x, y) => (x - y) * (x - y)) |> list.fold(0.0, (acc, v) => acc + v)
    out = out + [[math.sqrt(sse / df)]]
    n = n + 1
  }
  matrix.from_lists(out)
}

// rmse(a, a) = 0.
test "rmse of identical rows is zero" {
  let a = matrix.from_lists([[1.0, 2.0, 3.0, 4.0]])
  let y = rmse_rows(a, a)
  assert_eq(matrix.get(y, 0, 0), 0.0)
}

// √((3²+4²)/2) = √12.5.
test "rmse of zero to three-four is sqrt twelve-point-five" {
  let a = matrix.from_lists([[0.0, 0.0]])
  let b = matrix.from_lists([[3.0, 4.0]])
  let y = rmse_rows(a, b)
  assert(float.abs(matrix.get(y, 0, 0) - 3.5355339059327378) < 0.000000001, "√12.5")
}
