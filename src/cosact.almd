// cos_act — elementwise cos(x). Periodic activation; pairs with sin_act for
// Fourier / positional features. Elementwise.

import math

fn cos_act(m: Matrix) -> Matrix =
  matrix.map(m, (x) => math.cos(x))

test "cos at zero is one" {
  let y = cos_act(matrix.from_lists([[0.0]]))
  assert_eq(matrix.get(y, 0, 0), 1.0)
}

test "cos at pi is minus one" {
  let y = cos_act(matrix.from_lists([[3.141592653589793]]))
  assert(float.abs(matrix.get(y, 0, 0) + 1.0) < 0.000000001, "= -1")
}
